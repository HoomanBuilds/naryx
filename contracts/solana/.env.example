# Shell variables for the Solana Devnet runbook (deployments/solana/devnet/README.md). Placeholder
# values only; never commit a filled-in .env. The scripts take flags, not environment variables; load
# a filled copy and pass these as flag values, for example:
#
#   set -a; . ./.env; set +a
#   node scripts/initialize-devnet.mjs --cluster devnet --rpc-url "$SOLANA_DEVNET_RPC_URL" \
#     --release "$RELEASE_FILE" --plan "$PLAN_FILE" --payer "$PAYER_KEYPAIR" ...
#
# Every keypair path must be absolute, outside the repository, not the default Solana CLI wallet, and
# not readable by group or others (chmod 600); the scripts refuse anything else. Each script verifies
# the Devnet genesis hash from chain data and only simulates unless --send is given.

# Devnet RPC (https only). An RPC URL can carry a provider key: keep the filled file private.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# ---------------------------------------------------------------------------
# Keypairs, each a distinct Devnet-only key outside the repository
# ---------------------------------------------------------------------------

# Pays deployments, rent, and transaction fees.
PAYER_KEYPAIR=/absolute/path/outside/repository/devnet-payer.json
# Upgrade authority of every deployed Naryx program.
UPGRADE_AUTHORITY_KEYPAIR=/absolute/path/outside/repository/devnet-upgrade-authority.json
# Core governance proposer and executor (canceller and pauser are public keys in the plan).
PROPOSER_KEYPAIR=/absolute/path/outside/repository/devnet-proposer.json
EXECUTOR_KEYPAIR=/absolute/path/outside/repository/devnet-executor.json
# Owner of the naryx_test_perp market (pause, funding keeper rotation).
MARKET_OWNER_KEYPAIR=/absolute/path/outside/repository/devnet-market-owner.json
# The solver; its public key is the plan's solverId and the solver service's key file.
SOLVER_KEYPAIR=/absolute/path/outside/repository/devnet-solver.json
# Funds the test perp insurance and fee vaults with test USDC claimed from the faucet.
FUNDER_KEYPAIR=/absolute/path/outside/repository/devnet-funder.json
# Address lookup table authority.
LOOKUP_TABLE_AUTHORITY_KEYPAIR=/absolute/path/outside/repository/devnet-lookup-authority.json
# The new test USDC mint account (create-devnet-test-usdc.mjs --mint-keypair); used once.
TEST_USDC_MINT_KEYPAIR=/absolute/path/outside/repository/devnet-test-usdc-mint.json
# Program keypairs live in an external secret directory and are copied into the ignored
# target/deploy paths only for the deploy (see the runbook).
PROGRAM_KEYPAIR_DIR=/absolute/path/outside/repository/devnet-program-keypairs

# ---------------------------------------------------------------------------
# Deployed identities and operator files, filled in as the runbook proceeds
# ---------------------------------------------------------------------------

# naryx_test_perp program id (create-devnet-test-usdc.mjs --test-perp-program).
TEST_PERP_PROGRAM_ID=11111111111111111111111111111111
# The test USDC mint the faucet script created; the plan's quote mint.
TEST_USDC_MINT=11111111111111111111111111111111
# Candidate release manifest and initialization plan (both outside the repository).
RELEASE_FILE=/absolute/path/outside/repository/devnet-candidate-release.json
PLAN_FILE=/absolute/path/outside/repository/devnet-plan.json
# Records the scripts write with --out; the release generator reads them as template inputs.
INITIALIZE_RECORD=/absolute/path/outside/repository/devnet-initialize-record.json
LOOKUP_TABLE_RECORD=/absolute/path/outside/repository/devnet-lookup-table-record.json
