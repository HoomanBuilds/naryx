{
  "schemaVersion": 1,
  "network": "base-sepolia",
  "rpcUrlEnv": "NARYX_BASE_SEPOLIA_RPC_URL",
  "inputs": {
    "deploy": { "$operator": "absolute path of contracts/evm/broadcast/DeployBaseSepoliaAtomicPackage.s.sol/84532/run-latest.json" },
    "firm": { "$operator": "absolute path of contracts/evm/broadcast/DeployBaseSepoliaFirmLiquidity.s.sol/84532/runWith-latest.json (runWith-latest.json: the test USDC deployment runs runWith)" }
  },
  "contracts": {
    "protocolConfig": { "return": "deploy", "index": 0, "name": "ProtocolConfig" },
    "solverRegistry": { "return": "deploy", "index": 1, "name": "SolverRegistry" },
    "resourceRegistry": { "return": "deploy", "index": 2, "name": "ResourceRegistry" },
    "seriesRegistry": { "return": "deploy", "index": 3, "name": "CashCarrySeriesRegistry" },
    "quoteShardRegistry": { "return": "deploy", "index": 4, "name": "PackageQuoteShardRegistry" },
    "packageVerifier": { "return": "deploy", "index": 5, "name": "PackageVerifier" },
    "strategyAccountFactory": { "return": "deploy", "index": 6, "name": "NaryxStrategyAccountFactory" },
    "spotPort": { "return": "deploy", "index": 7, "name": "UniswapV3SpotPort" },
    "testPerpMarket": { "return": "deploy", "index": 8, "name": "NaryxTestPerpMarket" },
    "validationHelper": { "call": "packageVerifier", "fn": "validationHelper" },
    "referenceAccount": { "call": "strategyAccountFactory", "fn": "referenceAccount" },
    "uniswapPool": { "call": "spotPort", "fn": "pool" },
    "uniswapFactory": { "call": "spotPort", "fn": "factory", "expect": "0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24", "expectCodeHash": "0x02ee6e36873eea6fbb674a23d53b735646f12dc84efa08eac17872fe2fad9d06" },
    "uniswapQuoter": { "address": "0xC5290058841028F1614F3A6F0F5816cAd0df5E27", "expectCodeHash": "0x156c129c09f1c7abd7be44016fc679cd622ca2018484cee6806c213c1f8236b3" },
    "weth": { "call": "spotPort", "fn": "baseToken", "expect": "0x4200000000000000000000000000000000000006", "expectCodeHash": "0x83f731a17e6c0cdd04bc6f60b15d3e789e215b71403087b84b48650a1e5cbb21" },
    "quoteToken": { "call": "spotPort", "fn": "quoteToken" },
    "oracle": { "call": "testPerpMarket", "fn": "oracle", "expect": "0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1" },
    "reservationBook": { "return": "firm", "index": 0, "name": "FirmInventoryReservationBook" },
    "directSpotPort": { "return": "firm", "index": 1, "name": "DirectInventorySpotPort" },
    "quoteShard": { "return": "firm", "index": 2, "name": "PackageQuoteShard" },
    "bondVault": { "return": "firm", "index": 3, "name": "PerformanceBondVault" }
  },
  "domainManifest": {
    "manifestVersion": 2,
    "environment": "testnet",
    "domainId": "eip155:84532",
    "runtimeClassId": "naryx-evm",
    "runtimeClassVersion": 1,
    "chainNamespace": "eip155",
    "chainReference": "84532",
    "executionVerifierId": "package-verifier-v1",
    "executionVerifierCodeHash": { "$release": "contracts.packageVerifier.codeHashBytes" },
    "clockModelId": "evm-unix-seconds",
    "finalityPolicyHash": { "$bytes": { "$operator": "reviewed finality policy manifest hash (0x + 64 hex), the one used for the domain rotation" } },
    "addressCodecId": "evm-address-20",
    "supportedSettlementClasses": ["ATOMIC_POSTCONDITION"]
  },
  "domainCheck": { "contract": "protocolConfig" },
  "templateCheck": { "contract": "protocolConfig", "definition": "templateManifestHash" },
  "definitions": {
    "domain": { "$release": "domainRef" },
    "res": {
      "baseAsset": { "subjectId": { "$operator": "WETH asset subject id registered in configure step 5 (route baseAsset)" }, "manifestVersion": 1, "manifestHash": { "$bytes": { "$operator": "WETH asset manifest hash" } } },
      "quoteAsset": { "subjectId": { "$operator": "quote (Naryx Test USDC) asset subject id (route quoteAsset)" }, "manifestVersion": 1, "manifestHash": { "$bytes": { "$operator": "quote asset manifest hash" } } },
      "spotVenue": { "subjectId": { "$operator": "Uniswap V3 venue subject id (route spotVenue)" }, "manifestVersion": 1, "manifestHash": { "$bytes": { "$operator": "spot venue manifest hash" } } },
      "perpetualVenue": { "subjectId": { "$operator": "test perp venue subject id (route perpetualVenue)" }, "manifestVersion": 1, "manifestHash": { "$bytes": { "$operator": "perpetual venue manifest hash" } } },
      "spotMarket": { "subjectId": { "$operator": "WETH/quote pool market subject id (route spotMarket)" }, "manifestVersion": 1, "manifestHash": { "$bytes": { "$operator": "spot market manifest hash" } } },
      "perpetualMarket": { "subjectId": { "$operator": "test perp market subject id (route perpetualMarket)" }, "manifestVersion": 1, "manifestHash": { "$bytes": { "$operator": "perpetual market manifest hash" } } },
      "spotAdapter": { "subjectId": { "$operator": "spot adapter subject id (route spotAdapter)" }, "manifestVersion": 1, "manifestHash": { "$bytes": { "$operator": "spot adapter manifest hash" } } },
      "perpetualAdapter": { "subjectId": { "$operator": "perpetual adapter subject id (route perpetualAdapter)" }, "manifestVersion": 1, "manifestHash": { "$bytes": { "$operator": "perpetual adapter manifest hash" } } }
    },
    "baseAssetRef": { "assetId": { "$def": "res.baseAsset.subjectId" }, "assetManifestHash": { "$def": "res.baseAsset.manifestHash" }, "decimals": 18 },
    "quoteAssetRef": { "assetId": { "$def": "res.quoteAsset.subjectId" }, "assetManifestHash": { "$def": "res.quoteAsset.manifestHash" }, "decimals": 6 },
    "spotAdapterRef": { "adapterId": { "$def": "res.spotAdapter.subjectId" }, "adapterManifestVersion": { "$def": "res.spotAdapter.manifestVersion" }, "adapterManifestHash": { "$def": "res.spotAdapter.manifestHash" } },
    "perpetualAdapterRef": { "adapterId": { "$def": "res.perpetualAdapter.subjectId" }, "adapterManifestVersion": { "$def": "res.perpetualAdapter.manifestVersion" }, "adapterManifestHash": { "$def": "res.perpetualAdapter.manifestHash" } },
    "maxVenueFeeAtoms": { "$bigint": { "$operator": "max venue fees per package (Uniswap pool fee plus test perp taker fee), quote atoms; the order cap and the fee policy pass-through limit" } },
    "activation": {
      "activationUnit": "EVM_UNIX_SECONDS",
      "activationValue": { "$bigint": { "$operator": "unix time at which the registered records became active" } },
      "governanceReference": { "$operator": "governance reference string recorded with the registrations" }
    },
    "templateManifest": {
      "manifestVersion": 1,
      "environment": "testnet",
      "templateId": "cash-and-carry-v1",
      "templateVersion": 1,
      "supportedDomains": [{ "$def": "domain" }],
      "orderSchemaHash": { "$bytes": { "$operator": "reviewed order schema hash" } },
      "quoteSchemaHash": { "$bytes": { "$operator": "reviewed quote schema hash" } },
      "routeSchemaHash": { "$bytes": { "$operator": "reviewed route schema hash" } },
      "receiptSchemaHash": { "$bytes": { "$operator": "reviewed receipt schema hash" } },
      "entryCompilerVersion": 1,
      "exitCompilerVersion": 1,
      "legCount": 2,
      "legTypes": ["spot-purchase", "perp-sale"],
      "supportedDirections": ["LONG_SPOT_SHORT_PERP"],
      "supportedSettlementClasses": ["ATOMIC_POSTCONDITION"],
      "allowedSpotAdapterIds": [{ "$def": "res.spotAdapter.subjectId" }],
      "allowedPerpAdapterIds": [{ "$def": "res.perpetualAdapter.subjectId" }],
      "riskPolicyHash": { "$bytes": { "$operator": "reviewed risk policy hash" } }
    },
    "templateManifestHash": { "$protocol": "packageTemplateManifestHash", "args": [{ "$def": "templateManifest" }] },
    "templateRegistryRecord": {
      "$merge": [
        {
          "recordVersion": 1,
          "environment": "testnet",
          "domain": { "$def": "domain" },
          "templateId": "cash-and-carry-v1",
          "templateVersion": 1,
          "packageTemplateManifestHash": { "$def": "templateManifestHash" },
          "registryState": "ACTIVE"
        },
        { "$def": "activation" }
      ]
    },
    "feePolicyManifest": {
      "schemaVersion": 1,
      "manifestVersion": 1,
      "environment": "testnet",
      "domain": { "$def": "domain" },
      "scopeDirection": "LONG_SPOT_SHORT_PERP",
      "scopeQuantityPolicyClass": "EXACT_ATOMIC",
      "scopeSettlementClass": "ATOMIC_POSTCONDITION",
      "scopeAccountModeClass": "user-owned-v1",
      "feePolicyVersion": 1,
      "activationUnit": "EVM_UNIX_SECONDS",
      "activationValue": { "$def": "activation.activationValue" },
      "serviceFeeRules": [],
      "passThroughCostRules": [{
        "costCategory": "VENUE",
        "costAssetId": { "$def": "res.quoteAsset.subjectId" },
        "costAssetManifestHash": { "$def": "res.quoteAsset.manifestHash" },
        "costAssetDecimals": 6,
        "maxAtoms": { "$def": "maxVenueFeeAtoms" },
        "roundingDirection": "TOWARD_ZERO",
        "refundRule": "REFUND_UNUSED_PREPAID_TO_OWNER"
      }],
      "refundPolicyVersion": 1,
      "expiryUnit": "EVM_UNIX_SECONDS",
      "expiryValue": { "$bigint": { "$operator": "fee policy expiry, unix seconds" } }
    },
    "recordCommon": {
      "$merge": [
        {
          "recordVersion": 1,
          "environment": "testnet",
          "domain": { "$def": "domain" },
          "registryState": "ACTIVE",
          "riskLimits": [],
          "allowedTemplates": [{ "templateId": "cash-and-carry-v1", "templateVersion": 1, "packageTemplateManifestHash": { "$def": "templateManifestHash" } }],
          "allowedSettlementClasses": ["ATOMIC_POSTCONDITION"]
        },
        { "$def": "activation" }
      ]
    },
    "deployment": {
      "domainManifest": { "$release": "domainManifest" },
      "deploymentChainReference": { "$release": "chainId" },
      "strategyAccountFactory": { "$contract": "strategyAccountFactory" },
      "strategyAccountCodeHash": { "$release": "contracts.referenceAccount.codeHash" },
      "packageVerifier": { "$contract": "packageVerifier" },
      "settlementClass": { "classId": { "$keccak": "ATOMIC_POSTCONDITION" }, "classVersion": 1 },
      "spot": {
        "adapter": { "$merge": [{ "$def": "res.spotAdapter" }, { "$contract": "spotPort" }] },
        "adapterClassId": "base-strategy-spot-adapter-v1",
        "adapterClassVersion": 1,
        "market": { "$merge": [{ "$def": "res.spotMarket" }, { "$contract": "uniswapPool" }] },
        "venue": { "$merge": [{ "$def": "res.spotVenue" }, { "$contract": "uniswapFactory" }] },
        "baseLotAtoms": { "$bigint": { "$operator": "route spotMarketParameters.baseLotAtoms" } }
      },
      "perpetual": {
        "adapter": { "$merge": [{ "$def": "res.perpetualAdapter" }, { "$contract": "packageVerifier" }] },
        "adapterClassId": "base-strategy-perp-port-v1",
        "adapterClassVersion": 1,
        "market": { "$merge": [{ "$def": "res.perpetualMarket" }, { "$contract": "testPerpMarket" }] },
        "venue": { "$merge": [{ "$def": "res.perpetualVenue" }, { "$contract": "testPerpMarket" }] },
        "baseLotAtoms": { "$bigint": { "$operator": "route perpetualMarketParameters.baseLotAtoms" } }
      },
      "perpetualObserver": { "$contract": "testPerpMarket" },
      "baseAsset": { "$merge": [{ "$def": "res.baseAsset" }, { "$contract": "weth" }, { "decimals": 18 }] },
      "quoteAsset": { "$merge": [{ "$def": "res.quoteAsset" }, { "$contract": "quoteToken" }, { "decimals": 6 }] }
    },
    "seriesBinding": {
      "schemaVersion": 1,
      "bindingVersion": { "$number": { "$operator": "route seriesBindingVersion" } },
      "domain": { "$def": "domain" },
      "seriesManifestHash": { "$bytes": { "$operator": "route seriesManifestHash" } },
      "executionClassManifestHash": { "$bytes": { "$operator": "route executionClassManifestHash" } },
      "templateId": "cash-and-carry-v1",
      "templateVersion": 1,
      "templateManifestHash": { "$def": "templateManifestHash" },
      "settlementClass": "ATOMIC_POSTCONDITION",
      "settlementClassVersion": 1,
      "baseAsset": { "subjectIdentity": { "$keccak": { "$def": "res.baseAsset.subjectId" } }, "manifestVersion": { "$def": "res.baseAsset.manifestVersion" }, "manifestHash": { "$def": "res.baseAsset.manifestHash" } },
      "quoteAsset": { "subjectIdentity": { "$keccak": { "$def": "res.quoteAsset.subjectId" } }, "manifestVersion": { "$def": "res.quoteAsset.manifestVersion" }, "manifestHash": { "$def": "res.quoteAsset.manifestHash" } },
      "quoteConvention": "annualized-net-yield-v1",
      "entrySide": "ASK",
      "spotBaseAtomsPerPackageUnit": { "$bigint": { "$operator": "route spotBaseAtomsPerPackageUnit" } },
      "perpQuantityAtomsPerPackageUnit": { "$bigint": { "$operator": "route perpetualQuantityWadPerPackageUnit" } }
    },
    "solverAddress": { "$operator": "active solver EVM address that co-signs SolverAuthorization (the route solver)" },
    "contextId": { "$operator": "order context id, for example base-sepolia:weth-usdc:test-perp" },
    "keeperScopeId": { "$operator": "keeper readiness scope id for this lane, equal to its incident journal scope" },
    "codeWatch": { "chainRef": "eip155:84532", "scopeId": { "$def": "keeperScopeId" } }
  },
  "outputs": {
    "api/base-sepolia-runtime.json": {
      "format": "protocol-json",
      "content": {
        "schemaVersion": 1,
        "activationState": "ACTIVE",
        "deployment": {
          "admission": {
            "domainManifest": { "$release": "domainManifest" },
            "templateManifest": { "$def": "templateManifest" },
            "templateRegistryRecord": { "$def": "templateRegistryRecord" },
            "feePolicyManifest": { "$def": "feePolicyManifest" },
            "accountModeClass": "user-owned-v1",
            "activeRegistryRecords": [
              { "$merge": [{ "$def": "recordCommon" }, { "recordKind": "ASSET", "subjectId": { "$def": "res.baseAsset.subjectId" }, "subjectManifestVersion": { "$def": "res.baseAsset.manifestVersion" }, "subjectManifestHash": { "$def": "res.baseAsset.manifestHash" } }] },
              { "$merge": [{ "$def": "recordCommon" }, { "recordKind": "ASSET", "subjectId": { "$def": "res.quoteAsset.subjectId" }, "subjectManifestVersion": { "$def": "res.quoteAsset.manifestVersion" }, "subjectManifestHash": { "$def": "res.quoteAsset.manifestHash" } }] },
              { "$merge": [{ "$def": "recordCommon" }, { "recordKind": "ADAPTER", "subjectId": { "$def": "res.spotAdapter.subjectId" }, "subjectManifestVersion": { "$def": "res.spotAdapter.manifestVersion" }, "subjectManifestHash": { "$def": "res.spotAdapter.manifestHash" } }] },
              { "$merge": [{ "$def": "recordCommon" }, { "recordKind": "ADAPTER", "subjectId": { "$def": "res.perpetualAdapter.subjectId" }, "subjectManifestVersion": { "$def": "res.perpetualAdapter.manifestVersion" }, "subjectManifestHash": { "$def": "res.perpetualAdapter.manifestHash" } }] },
              { "$merge": [{ "$def": "recordCommon" }, { "recordKind": "VENUE", "subjectId": { "$def": "res.spotVenue.subjectId" }, "subjectManifestVersion": { "$def": "res.spotVenue.manifestVersion" }, "subjectManifestHash": { "$def": "res.spotVenue.manifestHash" } }] },
              { "$merge": [{ "$def": "recordCommon" }, { "recordKind": "VENUE", "subjectId": { "$def": "res.perpetualVenue.subjectId" }, "subjectManifestVersion": { "$def": "res.perpetualVenue.manifestVersion" }, "subjectManifestHash": { "$def": "res.perpetualVenue.manifestHash" } }] },
              { "$merge": [{ "$def": "recordCommon" }, { "recordKind": "MARKET", "subjectId": { "$def": "res.spotMarket.subjectId" }, "subjectManifestVersion": { "$def": "res.spotMarket.manifestVersion" }, "subjectManifestHash": { "$def": "res.spotMarket.manifestHash" } }] },
              { "$merge": [{ "$def": "recordCommon" }, { "recordKind": "MARKET", "subjectId": { "$def": "res.perpetualMarket.subjectId" }, "subjectManifestVersion": { "$def": "res.perpetualMarket.manifestVersion" }, "subjectManifestHash": { "$def": "res.perpetualMarket.manifestHash" } }] }
            ]
          },
          "deployment": { "$def": "deployment" },
          "uniswapV3": {
            "spotPort": { "$contract": "spotPort" },
            "pool": { "$contract": "uniswapPool" },
            "factory": { "$contract": "uniswapFactory" }
          },
          "conformancePerpetual": {
            "instrument": { "$contract": "testPerpMarket" },
            "observer": { "$contract": "testPerpMarket" },
            "evidenceLabel": "BASE_SEPOLIA_CONFORMANCE_ONLY"
          },
          "seriesBindingInput": { "$def": "seriesBinding" },
          "executionPolicy": {
            "solver": { "$def": "solverAddress" },
            "oracleMoveAllowanceBps": { "$number": { "$operator": "reviewed oracle move allowance between authorization and execution, bps below 1000" } }
          },
          "atomicEvidenceClass": "PACKAGE_VERIFIER_ATOMIC_V1",
          "finality": {
            "policy": {
              "requiredConfirmations": { "$number": { "$operator": "reviewed finality policy requiredConfirmations" } },
              "requireFinalized": { "$operator": "reviewed finality policy requireFinalized, true or false" }
            },
            "manifestHash": { "$release": "domainManifest.finalityPolicyHash" }
          }
        }
      }
    },
    "api/base-sepolia-order-context.json": {
      "format": "protocol-json",
      "content": {
        "schemaVersion": 1,
        "contextId": { "$def": "contextId" },
        "orderVersion": 1,
        "templateId": "cash-and-carry-v1",
        "templateVersion": 1,
        "packageTemplateManifestHash": { "$def": "templateManifestHash" },
        "baseAsset": { "$def": "baseAssetRef" },
        "quoteAsset": { "$def": "quoteAssetRef" },
        "spotAdapter": { "$def": "spotAdapterRef" },
        "perpetualAdapter": { "$def": "perpetualAdapterRef" },
        "spotQuoter": { "$contract": "uniswapQuoter" },
        "maxStalenessSeconds": { "$bigint": { "$operator": "max order context staleness, seconds (recommended 60: several poll intervals plus RPC hiccups)" } },
        "pollIntervalMs": { "$number": { "$operator": "price poll interval, ms, at least 1000 (recommended 5000)" } },
        "expiryTtlSeconds": { "$bigint": { "$operator": "order expiry TTL, seconds (recommended 600: a first-time user reads two wallet prompts)" } },
        "maxEntrySpread": {
          "baseAsset": { "$def": "baseAssetRef" },
          "quoteAsset": { "$def": "quoteAssetRef" },
          "quoteAtoms": { "$bigint": { "$operator": "max entry spread numerator, quote atoms (the fraction must be in lowest terms: 50 quote per WETH is 1 / 20000000000)" } },
          "baseAtoms": { "$bigint": { "$operator": "max entry spread denominator, base atoms" } },
          "roundingDirection": "CEIL"
        },
        "maximumQuantityAtoms": { "$bigint": { "$operator": "max order size, WETH atoms (recommended at most 1% of the WETH seeded in the spot pool: every entry buys WETH from that pool, so its depth bounds all users' open positions together)" } },
        "maxSlippageBps": { "$number": { "$operator": "max slippage, bps (recommended 100; bounds and refusals already include each order's price impact from the pinned quoter, so this covers pool movement between order creation and execution)" } },
        "maxVenueFeeAtomsByAsset": [{ "asset": { "$def": "quoteAssetRef" }, "maxAtoms": { "$def": "maxVenueFeeAtoms" } }],
        "maxMarginAddedAtoms": { "$bigint": { "$operator": "max perp margin added, USDC atoms" } },
        "maxProtocolFeeAtoms": { "$bigint": { "$operator": "max protocol fee, USDC atoms" } },
        "maxSolverFeeAtoms": { "$bigint": { "$operator": "max solver fee, USDC atoms" } },
        "maxPriorityFeeAtoms": { "$bigint": { "$operator": "max priority fee, USDC atoms" } },
        "maxAccountFundingAtoms": { "$bigint": { "$operator": "max single wallet funding proposal, USDC atoms" } }
      }
    },
    "solver/base-sepolia-quote.json": {
      "format": "protocol-json",
      "content": {
        "version": 1,
        "market": {
          "templateRegistryRecordHash": { "$protocol": "packageTemplateRegistryRecordHash", "args": [{ "$def": "templateRegistryRecord" }] },
          "candidateId": { "$operator": "solver candidate id" },
          "capacityBaseAtoms": { "$bigint": { "$operator": "solver capacity, WETH atoms" } },
          "solverId": { "$operator": "solver id the route names (route.solver)" },
          "solverCapabilityManifestHash": { "$bytes": { "$operator": "solver capability manifest hash" } },
          "feePolicyVersion": 1,
          "feePolicyManifestHash": { "$protocol": "feePolicyManifestHash", "args": [{ "$def": "feePolicyManifest" }] },
          "routeTtlSeconds": { "$bigint": { "$operator": "route TTL, seconds (recommended 180: covers the authorization signature, preparation, and the wallet transaction; slippage bounds bound the price risk)" } },
          "marginBps": { "$number": { "$operator": "perp margin as bps of entry notional" } },
          "perpSlippageBps": { "$number": { "$operator": "perp slippage, bps" } },
          "spot": {
            "adapter": { "$def": "spotAdapterRef" },
            "venue": { "$def": "res.spotVenue" },
            "market": { "$def": "res.spotMarket" },
            "action": { "$operator": "reviewed spot ActionCommitmentInput (sequence 0, adapter = spot adapter ref)" }
          },
          "perpetual": {
            "adapter": { "$def": "perpetualAdapterRef" },
            "venue": { "$def": "res.perpetualVenue" },
            "market": { "$def": "res.perpetualMarket" },
            "action": { "$operator": "reviewed perpetual ActionCommitmentInput (sequence 1, adapter = perpetual adapter ref)" }
          },
          "strategyAccountBindingId": "strategy-account",
          "accountBindings": { "$operator": "reviewed RouteAccountBindingInput[] including routeBindingId strategy-account" },
          "preconditions": { "$operator": "reviewed route preconditions" },
          "postconditions": { "$operator": "reviewed route postconditions" },
          "evidenceRequirements": { "$operator": "reviewed EvidenceRequirementsInput (profile package-verifier-atomic-v1)" }
        }
      }
    },
    "api/testnet-execution-policy.json": {
      "format": "json",
      "content": {
        "domains": [{
          "domainId": "eip155:84532",
          "quoteAssetId": { "$def": "res.quoteAsset.subjectId" },
          "maxPrincipalAtomsPerOperation": { "$operator": "per-operation principal cap, USDC atoms, decimal string" },
          "maxRecoveryLossAtomsPerOperation": { "$operator": "per-operation recovery loss cap, USDC atoms, decimal string" }
        }]
      }
    },
    "keeper/code-watchlist.json": {
      "format": "protocol-json",
      "content": {
        "intervalMs": 60000,
        "evidenceTtlMs": { "$naryxType": "bigint", "value": "300000" },
        "journals": [{
          "journalPath": { "$data": "keeper/base-sepolia-incidents.json" },
          "readinessDecision": { "$operator": "current ReadinessDecision for this scope; use {\"$input\": \"readinessDecision\"} with an inputs entry" }
        }],
        "targets": [
          { "$merge": [{ "$def": "codeWatch" }, { "targetId": "base-sepolia-protocol-config", "address": { "$release": "contracts.protocolConfig.addressLower" }, "expectedCodeHash": { "$release": "contracts.protocolConfig.codeHash" } }] },
          { "$merge": [{ "$def": "codeWatch" }, { "targetId": "base-sepolia-solver-registry", "address": { "$release": "contracts.solverRegistry.addressLower" }, "expectedCodeHash": { "$release": "contracts.solverRegistry.codeHash" } }] },
          { "$merge": [{ "$def": "codeWatch" }, { "targetId": "base-sepolia-resource-registry", "address": { "$release": "contracts.resourceRegistry.addressLower" }, "expectedCodeHash": { "$release": "contracts.resourceRegistry.codeHash" } }] },
          { "$merge": [{ "$def": "codeWatch" }, { "targetId": "base-sepolia-series-registry", "address": { "$release": "contracts.seriesRegistry.addressLower" }, "expectedCodeHash": { "$release": "contracts.seriesRegistry.codeHash" } }] },
          { "$merge": [{ "$def": "codeWatch" }, { "targetId": "base-sepolia-quote-shard-registry", "address": { "$release": "contracts.quoteShardRegistry.addressLower" }, "expectedCodeHash": { "$release": "contracts.quoteShardRegistry.codeHash" } }] },
          { "$merge": [{ "$def": "codeWatch" }, { "targetId": "base-sepolia-package-verifier", "address": { "$release": "contracts.packageVerifier.addressLower" }, "expectedCodeHash": { "$release": "contracts.packageVerifier.codeHash" } }] },
          { "$merge": [{ "$def": "codeWatch" }, { "targetId": "base-sepolia-validation-helper", "address": { "$release": "contracts.validationHelper.addressLower" }, "expectedCodeHash": { "$release": "contracts.validationHelper.codeHash" } }] },
          { "$merge": [{ "$def": "codeWatch" }, { "targetId": "base-sepolia-account-factory", "address": { "$release": "contracts.strategyAccountFactory.addressLower" }, "expectedCodeHash": { "$release": "contracts.strategyAccountFactory.codeHash" } }] },
          { "$merge": [{ "$def": "codeWatch" }, { "targetId": "base-sepolia-spot-port", "address": { "$release": "contracts.spotPort.addressLower" }, "expectedCodeHash": { "$release": "contracts.spotPort.codeHash" } }] },
