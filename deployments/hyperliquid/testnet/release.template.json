{
  "schemaVersion": 1,
  "network": "hyperliquid-testnet",
  "domainManifest": {
    "manifestVersion": { "$number": { "$operator": "reviewed hypercore:testnet domain manifest version" } },
    "environment": "testnet",
    "domainId": "hypercore:testnet",
    "runtimeClassId": { "$operator": "reviewed HyperCore runtime class id" },
    "runtimeClassVersion": { "$number": { "$operator": "reviewed runtime class version" } },
    "chainNamespace": { "$operator": "reviewed chain namespace" },
    "chainReference": "testnet",
    "executionVerifierId": { "$operator": "reviewed execution verifier id" },
    "executionVerifierCodeHash": { "$bytes": { "$operator": "reviewed execution verifier code hash" } },
    "clockModelId": { "$operator": "reviewed clock model id" },
    "finalityPolicyHash": { "$bytes": { "$operator": "reviewed finality policy manifest hash" } },
    "addressCodecId": { "$operator": "reviewed address codec id" },
    "supportedSettlementClasses": ["BATCHED_IOC_WITH_RECOVERY"]
  },
  "definitions": {
    "domainHashHex": { "$hex": { "$release": "domainManifestHash" } },
    "tradingAccount": { "$lower": { "$operator": "Hyperliquid Testnet trading account address (lowercase 0x + 40 hex)" } },
    "solverId": { "$operator": "solver id" },
    "spot": {
      "adapterId": { "$operator": "spot adapter id" }, "adapterManifestVersion": 1, "adapterManifestHash": { "$hex": { "$operator": "spot adapter manifest hash" } },
      "venueId": { "$operator": "spot venue id" }, "venueManifestVersion": 1, "venueManifestHash": { "$hex": { "$operator": "spot venue manifest hash" } },
      "marketId": { "$operator": "spot market id" }, "marketManifestVersion": 1, "marketManifestHash": { "$hex": { "$operator": "spot market manifest hash" } },
      "assetId": { "$number": { "$operator": "spot asset id (10000 + universe index)" } },
      "sizeDecimals": { "$number": { "$operator": "spot size decimals (spotMeta szDecimals)" } },
      "tokenIndex": { "$number": { "$operator": "spot base token index" } },
      "universeIndex": { "$number": { "$operator": "spot universe index" } }
    },
    "perpetual": {
      "adapterId": { "$operator": "perpetual adapter id" }, "adapterManifestVersion": 1, "adapterManifestHash": { "$hex": { "$operator": "perpetual adapter manifest hash" } },
      "venueId": { "$operator": "perpetual venue id" }, "venueManifestVersion": 1, "venueManifestHash": { "$hex": { "$operator": "perpetual venue manifest hash" } },
      "marketId": { "$operator": "perpetual market id" }, "marketManifestVersion": 1, "marketManifestHash": { "$hex": { "$operator": "perpetual market manifest hash" } },
      "assetId": { "$number": { "$operator": "perpetual asset id" } },
      "sizeDecimals": { "$number": { "$operator": "perpetual size decimals (meta szDecimals)" } },
      "assetIndex": { "$number": { "$operator": "perpetual asset index in meta.universe" } }
    },
    "baseAsset": { "assetId": { "$operator": "base asset id" }, "assetManifestHash": { "$hex": { "$operator": "base asset manifest hash" } }, "decimals": { "$number": { "$operator": "base asset decimals: the spot base token's spotMeta weiDecimals (its full balance precision, at least both size decimals)" } } },
    "quoteAsset": { "assetId": { "$operator": "quote asset id" }, "assetManifestHash": { "$hex": { "$operator": "quote asset manifest hash" } }, "decimals": { "$number": { "$operator": "quote asset decimals: the quote token's spotMeta weiDecimals" } } },
    "spotAdapterRef": { "adapterId": { "$def": "spot.adapterId" }, "adapterManifestVersion": { "$def": "spot.adapterManifestVersion" }, "adapterManifestHash": { "$def": "spot.adapterManifestHash" } },
    "perpetualAdapterRef": { "adapterId": { "$def": "perpetual.adapterId" }, "adapterManifestVersion": { "$def": "perpetual.adapterManifestVersion" }, "adapterManifestHash": { "$def": "perpetual.adapterManifestHash" } },
    "packageTemplateManifestHash": { "$hex": { "$operator": "reviewed cash-and-carry template manifest hash for hypercore:testnet" } },
    "quoteTokenIndex": { "$number": { "$operator": "quote token index (spotMeta tokens index of USDC, normally 0)" } },
    "cashCarryGeneralized": {
      "laneId": { "$operator": "reviewed cash-and-carry generalized quote lane id" },
      "executionClassId": { "$operator": "reviewed cash-and-carry execution class id" },
      "executionClassVersion": { "$number": { "$operator": "reviewed cash-and-carry execution class version" } },
      "executionClassManifestHash": { "$bytes": { "$operator": "reviewed cash-and-carry execution class manifest hash" } },
      "holdingDurationMs": { "$bigint": { "$operator": "cash-and-carry pricing horizon in milliseconds" } },
      "expectedExitBasisBps": { "$bigint": { "$operator": "cash-and-carry expected exit basis in signed bps" } },
      "reversalThresholdPpm": 1
    },
    "cashCarryStrategyPreparation": { "$operator": "reviewed version 1 HyperCore Testnet cash-and-carry strategy preparation config" },
    "treasuryStrategyPreparation": { "$operator": "reviewed version 1 HyperCore Testnet treasury inventory hedge strategy preparation config" },
    "fundingStrategyPreparation": { "$operator": "reviewed version 1 HyperCore Testnet perpetual funding spread strategy preparation config" },
    "treasuryStrategyQuote": { "$operator": "reviewed version 2 HyperCore Testnet treasury inventory hedge quote config with embedded generalized settings" },
    "fundingStrategyQuote": { "$operator": "reviewed version 2 HyperCore Testnet perpetual funding spread quote config with embedded generalized settings" },
    "nativeStrategyOrderProfiles": { "$operator": "reviewed version 1 Testnet native strategy order profile file containing treasury hedge and funding spread profiles" },
    "publicStrategyMarketSupport": { "$operator": "reviewed version 1 package exchange support manifest covering every generated HyperCore native strategy series and execution class" },
    "publicStrategyMarketBootstrap": { "$operator": "reviewed version 1 Testnet public market bootstrap containing the HyperCore domain and template manifests, matching policies, economic series, execution classes, and open books" },
    "publicStrategyGraphContext": { "$operator": "reviewed version 1 graph compilation context containing the active HyperCore registry records and resource limits for every generated native strategy profile" },
    "executionEnabled": { "$operator": "true to execute Hyperliquid Testnet packages (needs the approved agent key and a funded trading account), false for quotes only" },
    "executor": {
      "agentAddress": { "$lower": { "$operator": "approved Hyperliquid Testnet API (agent) wallet address, lowercase 0x + 40 hex" } },
      "agentKeyPath": { "$operator": "absolute path, outside the repository, of that agent wallet's key file (the path only; the key is never read here)" },
      "accountKind": { "$operator": "MASTER when the trading account is the master account, SUBACCOUNT when it is a subaccount" },
      "masterAccount": { "$lower": { "$operator": "Hyperliquid Testnet master account address, lowercase (equal to the trading account for MASTER)" } },
      "signerLeaseId": { "$operator": "signer lease id, a stable name for this executor process, for example hl-testnet-executor-1" },
      "spotUniverseName": { "$operator": "spotMeta universe name of the spot pair, for example @1" },
      "spotUniverseCanonical": { "$operator": "spotMeta universe isCanonical, true or false" },
      "spotTokenName": { "$operator": "spotMeta token name of the spot base token" },
      "spotTokenCanonical": { "$operator": "spotMeta token isCanonical of the spot base token, true or false" },
      "spotTokenId": { "$lower": { "$operator": "spotMeta tokenId of the spot base token, 0x + 32 hex" } },
      "quoteTokenName": { "$operator": "spotMeta token name of the quote token, normally USDC" },
      "quoteTokenCanonical": { "$operator": "spotMeta token isCanonical of the quote token, true or false" },
      "quoteTokenId": { "$lower": { "$operator": "spotMeta tokenId of the quote token, 0x + 32 hex" } },
      "perpetualName": { "$operator": "meta universe name of the perpetual, for example ETH" },
      "minimumSpotDepth": { "$operator": "minimum spot book depth the executor requires, decimal base units" },
      "minimumPerpetualDepth": { "$operator": "minimum perpetual book depth the executor requires, decimal base units" },
      "leverageMode": { "$operator": "perpetual leverage mode the trading account must use: cross or isolated" },
      "maxReferenceDivergenceBps": { "$operator": "max divergence between the spot and perpetual reference prices, bps (testnet books can sit far apart; measure before choosing, for example 500)" }
    }
  },
  "outputs": {
    "api/hyperliquid-testnet-runtime.json": {
      "format": "protocol-json",
      "content": {
        "version": 1,
        "environment": "TESTNET",
        "domain": { "domainId": "hypercore:testnet", "domainManifestVersion": { "$release": "domainManifest.manifestVersion" }, "domainManifestHash": { "$def": "domainHashHex" } },
        "seriesManifestHash": { "$hex": { "$operator": "series manifest hash" } },
        "executionClassManifestHash": { "$hex": { "$operator": "execution class manifest hash" } },
        "solverId": { "$def": "solverId" },
        "solverVerificationKey": { "$hex": { "$operator": "solver Ed25519 verification key, 64 hex (the common NARYX_SOLVER_ED25519_PUBLIC_KEY_HEX)" } },
        "market": {
          "spot": { "$def": "spot" },
          "perpetual": { "$def": "perpetual" },
          "quoteTokenIndex": { "$def": "quoteTokenIndex" }
        },
        "bounds": {
          "maxEvidenceAgeMs": { "$number": { "$operator": "max evidence age, ms (recommended 600000: a stuck package can be proven final and its lane released automatically only while now minus its checkpoint is within this bound; after that only an ABANDONED release by the operator frees the lane)" } },
          "maxFillPages": { "$number": { "$operator": "max fill pages (recommended 16, the collector default)" } },
          "maxSnapshotSkewMs": { "$number": { "$operator": "max snapshot skew, ms (recommended 10000: it spans every account snapshot read in one reconciliation, several sequential info requests from the host)" } }
        },
        "orderContext": {
          "contextId": { "$operator": "order context id" },
          "tradingAccount": { "$def": "tradingAccount" },
          "orderVersion": 1,
          "templateId": "cash-and-carry-v1",
          "templateVersion": 1,
          "packageTemplateManifestHash": { "$def": "packageTemplateManifestHash" },
          "baseAsset": { "$def": "baseAsset" },
          "quoteAsset": { "$def": "quoteAsset" },
          "spotAdapter": { "$def": "spotAdapterRef" },
          "perpetualAdapter": { "$def": "perpetualAdapterRef" },
          "maxStalenessMs": { "$bigint": { "$operator": "max staleness, ms, above refreshIntervalMs and at most 120000" } },
          "expiryTtlMs": { "$bigint": { "$operator": "order expiry TTL, ms (recommended 300000: the owner signs the authorization, then the shared account may queue behind another package)" } },
          "recoveryActionExpiryTtlMs": { "$bigint": { "$operator": "recovery action expiry TTL, ms" } },
          "recoveryDeadlineTtlMs": { "$bigint": { "$operator": "recovery deadline TTL, ms" } },
          "minRecoveryWindowMs": { "$bigint": { "$operator": "minimum recovery window, ms" } },
          "livePricing": {
            "refreshIntervalMs": { "$number": { "$operator": "book refresh interval, ms, 2000 to 60000" } },
            "maxBookAgeMs": { "$number": { "$operator": "max book age, ms" } },
            "maxBookSpreadBps": { "$number": { "$operator": "max book spread, bps" } },
            "recoveryBandBps": { "$number": { "$operator": "recovery band, bps" } },
            "feeShortfallSlackBps": { "$number": { "$operator": "fee shortfall slack, bps, at most 100" } }
          },
          "maxEntrySpread": {
            "baseAsset": { "$def": "baseAsset" },
            "quoteAsset": { "$def": "quoteAsset" },
            "quoteAtoms": { "$bigint": { "$operator": "max entry spread numerator" } },
            "baseAtoms": { "$bigint": { "$operator": "max entry spread denominator" } },
            "roundingDirection": "CEIL"
          },
          "maximumQuantityAtoms": { "$bigint": { "$operator": "max order size, base atoms at the base asset decimals (sizes must be whole lots of the coarser size grid)" } },
          "maxSlippageBps": { "$number": { "$operator": "max slippage, bps" } },
          "maxNetSpotShortfallAtoms": { "$bigint": { "$operator": "max net spot shortfall, base atoms" } },
          "maxNetSpotExcessAtoms": { "$bigint": { "$operator": "max net spot excess, base atoms" } },
          "maxTerminalResidualBaseQuantityAtoms": { "$bigint": { "$operator": "max terminal residual base quantity, base atoms: at least the largest spot-buy base fee plus one spot lot (10^(base decimals - spot size decimals)), since an exit sells whole lots and leaves the fee dust" } },
          "maxTerminalResidualQuoteValueAtoms": { "$bigint": { "$operator": "max terminal residual quote value" } },
          "maxVenueFeeAtomsByAsset": [{ "asset": { "$def": "quoteAsset" }, "maxAtoms": { "$bigint": { "$operator": "max venue fee, quote atoms" } } }],
          "maxMarginAddedAtoms": { "$bigint": { "$operator": "max margin added, quote atoms" } },
          "maxProtocolFeeAtoms": { "$bigint": { "$operator": "max protocol fee" } },
          "maxSolverFeeAtoms": { "$bigint": { "$operator": "max solver fee" } },
          "maxPriorityFeeAtoms": { "$bigint": { "$operator": "max priority fee" } },
          "minVenueReserveReturnedAtoms": { "$bigint": { "$operator": "min venue reserve returned" } },
          "minWalletQuoteBalanceDeltaAtoms": { "$bigint": { "$operator": "min wallet quote balance delta" } },
          "maxResidualBaseQuantityAtoms": { "$bigint": { "$operator": "max residual base quantity" } },
          "maxRecoveryCostAtomsByAsset": [{ "asset": { "$def": "quoteAsset" }, "maxAtoms": { "$bigint": { "$operator": "max recovery cost, quote atoms" } } }],
          "maxAggregateRecoveryLossQuoteAtoms": { "$bigint": { "$operator": "max aggregate recovery loss, quote atoms" } }
        },
        "omnibus": {
          "maxOpenPackagesPerOwner": { "$number": { "$operator": "open packages one owner wallet may hold in the shared trading account, 1 to 16, for example 1" } },
          "maxOpenNotionalQuoteAtoms": { "$bigint": { "$operator": "total entry notional the shared trading account carries across all owners, quote atoms, within its funded testnet balance" } }
        }
      }
    },
    "solver/hyperliquid-testnet-quote.json": {
      "format": "protocol-json",
      "content": {
        "version": 2,
        "generalized": { "$def": "cashCarryGeneralized" },
        "market": {
          "domain": { "$release": "domainRef" },
          "templateId": "cash-and-carry-v1",
          "templateVersion": 1,
          "packageTemplateManifestHash": { "$def": "packageTemplateManifestHash" },
          "templateRegistryRecordHash": { "$hex": { "$operator": "template registry record hash" } },
          "candidateId": { "$operator": "solver candidate id" },
          "capacityBaseAtoms": { "$bigint": { "$operator": "solver capacity, base atoms" } },
          "solverId": { "$def": "solverId" },
          "solverCapabilityManifestHash": { "$hex": { "$operator": "solver capability manifest hash" } },
          "feePolicyVersion": 1,
          "feePolicyManifestHash": { "$hex": { "$operator": "fee policy manifest hash" } },
          "routeTtlMs": { "$bigint": { "$operator": "route TTL, ms" } },
          "quoteTtlMs": { "$bigint": { "$operator": "quote TTL, ms" } },
          "marginBps": { "$number": { "$operator": "margin bps" } },
          "baseAsset": { "$def": "baseAsset" },
          "quoteAsset": { "$def": "quoteAsset" },
          "maxBookAgeMs": { "$number": { "$operator": "max book age, ms" } },
          "maxBookSpreadBps": { "$number": { "$operator": "max book spread, bps" } },
          "spot": {
            "adapter": { "$def": "spotAdapterRef" },
            "venue": { "subjectId": { "$def": "spot.venueId" }, "manifestVersion": { "$def": "spot.venueManifestVersion" }, "manifestHash": { "$def": "spot.venueManifestHash" } },
            "market": { "subjectId": { "$def": "spot.marketId" }, "manifestVersion": { "$def": "spot.marketManifestVersion" }, "manifestHash": { "$def": "spot.marketManifestHash" } },
            "coin": { "$operator": "spot l2Book coin, for example @1" },
            "sizeDecimals": { "$def": "spot.sizeDecimals" },
            "action": { "$operator": "reviewed spot ActionCommitmentInput" }
          },
          "perpetual": {
            "adapter": { "$def": "perpetualAdapterRef" },
            "venue": { "subjectId": { "$def": "perpetual.venueId" }, "manifestVersion": { "$def": "perpetual.venueManifestVersion" }, "manifestHash": { "$def": "perpetual.venueManifestHash" } },
            "market": { "subjectId": { "$def": "perpetual.marketId" }, "manifestVersion": { "$def": "perpetual.marketManifestVersion" }, "manifestHash": { "$def": "perpetual.marketManifestHash" } },
            "coin": { "$operator": "perpetual l2Book coin, for example ETH" },
            "sizeDecimals": { "$def": "perpetual.sizeDecimals" },
            "action": { "$operator": "reviewed perpetual ActionCommitmentInput" }
          },
          "accountBindings": { "$operator": "reviewed RouteAccountBindingInput[]" },
          "preconditions": { "$operator": "reviewed route preconditions" },
          "postconditions": { "$operator": "reviewed route postconditions" },
          "evidenceRequirements": { "$operator": "reviewed EvidenceRequirementsInput" },
          "recovery": {
            "policyVersion": { "$number": { "$operator": "recovery policy version" } },
            "controllerId": { "$operator": "recovery controller id" },
            "controllerCodeHash": { "$hex": { "$operator": "recovery controller code hash" } },
            "authorityModeId": { "$operator": "recovery authority mode id" },
            "reconciledStateSchemaHash": { "$hex": { "$operator": "reconciled state schema hash" } },
            "actionBuilderCodeHash": { "$hex": { "$operator": "recovery action builder code hash" } }
          }
        }
      }
    },
    "api/hyperliquid-native-strategy-order-profiles.json": {
      "format": "protocol-json",
      "content": { "$def": "nativeStrategyOrderProfiles" }
    },
    "api/hyperliquid-public-market-support.json": {
      "format": "protocol-json",
      "content": { "$def": "publicStrategyMarketSupport" }
    },
    "api/hyperliquid-public-market-bootstrap.json": {
      "format": "protocol-json",
      "content": { "$def": "publicStrategyMarketBootstrap" }
    },
    "api/hyperliquid-public-graph-context.json": {
      "format": "protocol-json",
      "content": { "$def": "publicStrategyGraphContext" }
    },
    "solver/hyperliquid-cash-carry-strategy-preparation.json": {
      "format": "protocol-json",
      "content": { "$def": "cashCarryStrategyPreparation" }
    },
    "solver/hyperliquid-treasury-strategy-preparation.json": {
      "format": "protocol-json",
      "content": { "$def": "treasuryStrategyPreparation" }
    },
    "solver/hyperliquid-funding-strategy-preparation.json": {
      "format": "protocol-json",
      "content": { "$def": "fundingStrategyPreparation" }
    },
    "solver/hyperliquid-treasury-quote.json": {
      "format": "protocol-json",
      "content": { "$def": "treasuryStrategyQuote" }
    },
    "solver/hyperliquid-funding-quote.json": {
      "format": "protocol-json",
      "content": { "$def": "fundingStrategyQuote" }
    },
    "api/testnet-execution-policy.json": {
      "format": "json",
      "content": {
        "domains": [{
          "domainId": "hypercore:testnet",
          "quoteAssetId": { "$def": "quoteAsset.assetId" },
          "maxPrincipalAtomsPerOperation": { "$operator": "per-operation principal cap, quote atoms, decimal string" },
          "maxRecoveryLossAtomsPerOperation": { "$operator": "per-operation recovery loss cap, quote atoms, decimal string" }
        }]
      }
    },
    "env/api.env": {
      "format": "env",
      "content": {
        "NARYX_HYPERLIQUID_TESTNET_RUNTIME_ENABLED": "true",
        "NARYX_HYPERLIQUID_TESTNET_ENVIRONMENT": "TESTNET",
        "NARYX_HYPERLIQUID_TESTNET_RUNTIME_CONFIG": { "$out": "api/hyperliquid-testnet-runtime.json" },
        "NARYX_HYPERLIQUID_TESTNET_EVIDENCE_ENABLED": { "$def": "executionEnabled" },
        "NARYX_HYPERLIQUID_TESTNET_EXECUTOR_CLIENT_ENABLED": { "$def": "executionEnabled" },
        "NARYX_HYPERLIQUID_TESTNET_EVIDENCE_ORIGIN": "http://127.0.0.1:8789",
        "NARYX_HYPERLIQUID_TESTNET_EXECUTOR_ORIGIN": "http://127.0.0.1:8792",
        "NARYX_API_HYPERLIQUID_TESTNET_EXECUTION_DB": { "$data": "api/hyperliquid-testnet-execution.db" },
        "NARYX_GENERALIZED_STRATEGY_PREPARATION_ENABLED": "true",
        "NARYX_HYPERLIQUID_NATIVE_STRATEGY_ORDER_PROFILES": { "$out": "api/hyperliquid-native-strategy-order-profiles.json" },
        "NARYX_PUBLIC_MARKET_ENABLED": "true",
        "NARYX_PUBLIC_ENVIRONMENT": "testnet",
        "NARYX_EXCHANGE_DB": { "$data": "api/package-exchange.db" },
        "NARYX_EXCHANGE_SUPPORT_MANIFEST": { "$out": "api/hyperliquid-public-market-support.json" },
        "NARYX_PUBLIC_MARKET_BOOTSTRAP": { "$out": "api/hyperliquid-public-market-bootstrap.json" },
        "NARYX_REGISTRY_DB": { "$data": "api/public-registry.db" },
        "NARYX_STRATEGY_PACKAGE_DB": { "$data": "api/strategy-packages.db" },
        "NARYX_GRAPH_COMPILE_CONTEXT": { "$out": "api/hyperliquid-public-graph-context.json" },
        "NARYX_GENERALIZED_STRATEGY_QUOTE_ENABLED": "true"
      }
    },
    "env/solver.env": {
      "format": "env",
      "content": {
        "NARYX_HYPERLIQUID_TESTNET_QUOTE_ENABLED": "true",
        "NARYX_HYPERLIQUID_TESTNET_QUOTE_CONFIG": { "$out": "solver/hyperliquid-testnet-quote.json" },
        "NARYX_HYPERLIQUID_STRATEGY_PREPARATION_CONFIGS": { "$join": [
          { "$out": "solver/hyperliquid-cash-carry-strategy-preparation.json" },
          { "$out": "solver/hyperliquid-treasury-strategy-preparation.json" },
          { "$out": "solver/hyperliquid-funding-strategy-preparation.json" }
        ], "separator": "," },
        "NARYX_HYPERLIQUID_TESTNET_GENERALIZED_QUOTE_ENABLED": "true",
        "NARYX_HYPERLIQUID_TESTNET_GENERALIZED_QUOTE_CONFIGS": { "$join": [
          { "$out": "solver/hyperliquid-testnet-quote.json" },
          { "$out": "solver/hyperliquid-treasury-quote.json" },
          { "$out": "solver/hyperliquid-funding-quote.json" }
        ], "separator": "," },
        "NARYX_HYPERLIQUID_TESTNET_TRADING_ACCOUNT": { "$def": "tradingAccount" },
        "NARYX_HYPERLIQUID_TESTNET_EXECUTOR_ENABLED": { "$def": "executionEnabled" },
        "NARYX_HYPERLIQUID_TESTNET_EXECUTOR_PORT": "8792",
        "NARYX_HYPERLIQUID_TESTNET_ENVIRONMENT": "TESTNET",
        "NARYX_HYPERLIQUID_TESTNET_KEEPER_ORIGIN": "http://127.0.0.1:8789",
        "NARYX_HYPERLIQUID_TESTNET_JOURNAL_DB": { "$data": "solver/hyperliquid-testnet-journal.db" },
        "NARYX_HYPERLIQUID_TESTNET_SIGNER_LEASE_ID": { "$def": "executor.signerLeaseId" },
        "NARYX_HYPERLIQUID_TESTNET_AGENT_ADDRESS": { "$def": "executor.agentAddress" },
        "NARYX_HYPERLIQUID_TESTNET_AGENT_KEY_PATH": { "$def": "executor.agentKeyPath" },
        "NARYX_HYPERLIQUID_TESTNET_ACCOUNT_KIND": { "$def": "executor.accountKind" },
        "NARYX_HYPERLIQUID_TESTNET_MASTER_ACCOUNT": { "$def": "executor.masterAccount" },
        "NARYX_HYPERLIQUID_TESTNET_SPOT_UNIVERSE_NAME": { "$def": "executor.spotUniverseName" },
        "NARYX_HYPERLIQUID_TESTNET_SPOT_UNIVERSE_CANONICAL": { "$def": "executor.spotUniverseCanonical" },
        "NARYX_HYPERLIQUID_TESTNET_SPOT_TOKEN_NAME": { "$def": "executor.spotTokenName" },
        "NARYX_HYPERLIQUID_TESTNET_SPOT_TOKEN_CANONICAL": { "$def": "executor.spotTokenCanonical" },
        "NARYX_HYPERLIQUID_TESTNET_SPOT_TOKEN_ID": { "$def": "executor.spotTokenId" },
        "NARYX_HYPERLIQUID_TESTNET_QUOTE_TOKEN_NAME": { "$def": "executor.quoteTokenName" },
        "NARYX_HYPERLIQUID_TESTNET_QUOTE_TOKEN_CANONICAL": { "$def": "executor.quoteTokenCanonical" },
        "NARYX_HYPERLIQUID_TESTNET_QUOTE_TOKEN_ID": { "$def": "executor.quoteTokenId" },
        "NARYX_HYPERLIQUID_TESTNET_PERPETUAL_NAME": { "$def": "executor.perpetualName" },
        "NARYX_HYPERLIQUID_TESTNET_SPOT_SIZE_DECIMALS": { "$def": "spot.sizeDecimals" },
        "NARYX_HYPERLIQUID_TESTNET_PERPETUAL_SIZE_DECIMALS": { "$def": "perpetual.sizeDecimals" },
        "NARYX_HYPERLIQUID_TESTNET_MINIMUM_SPOT_DEPTH": { "$def": "executor.minimumSpotDepth" },
        "NARYX_HYPERLIQUID_TESTNET_MINIMUM_PERPETUAL_DEPTH": { "$def": "executor.minimumPerpetualDepth" },
        "NARYX_HYPERLIQUID_TESTNET_ALLOWED_SPOT_TOKEN_INDICES": { "$join": [{ "$def": "spot.tokenIndex" }, { "$def": "quoteTokenIndex" }], "separator": "," },
        "NARYX_HYPERLIQUID_TESTNET_ALLOWED_PERPETUAL_COINS": { "$def": "executor.perpetualName" },
        "NARYX_HYPERLIQUID_TESTNET_EXPECTED_LEVERAGE_MODE": { "$def": "executor.leverageMode" },
        "NARYX_HYPERLIQUID_TESTNET_EXPECTED_PORTFOLIO_MARGIN_ENABLED": "false",
        "NARYX_HYPERLIQUID_TESTNET_MAX_BOOK_AGE_MS": "10000",
        "NARYX_HYPERLIQUID_TESTNET_MAX_BOOK_SNAPSHOT_SKEW_MS": "5000",
        "NARYX_HYPERLIQUID_TESTNET_MAX_REFERENCE_DIVERGENCE_BPS": { "$def": "executor.maxReferenceDivergenceBps" },
