# Environment for the release manifest generator (deployments/tools/release-manifests.mjs).
# Placeholder values only; never commit a filled-in .env. Load a filled copy, then run the generator
# as deployments/tools/README.md shows:
#
#   set -a; . ./deployments/.env; set +a
#   node deployments/tools/release-manifests.mjs --out <dir outside repo> --data-dir <dir outside repo> \
#     --release <common.json> --release <base-sepolia.json> --release <arbitrum-sepolia.json> \
#     --release <solana-devnet.json> --release <hyperliquid-testnet.json>
#
# The generator only reads chains. It writes env/api.env, env/solver.env, env/keeper.env,
# env/indexer-<network>.env, web/.env.production, and every runtime JSON the services load, then
# loads each one with the services' own code against the live testnets.

# ---------------------------------------------------------------------------
# Server-side read-only RPC (required for each network passed with --release)
# ---------------------------------------------------------------------------

# Also written into the API, solver, keeper, and indexer env files, so these may carry a private
# provider key. Network identity is checked from chain data (chain id, Solana genesis hash).
NARYX_BASE_SEPOLIA_RPC_URL=https://replace-with-reviewed-base-sepolia-rpc
NARYX_ARBITRUM_SEPOLIA_RPC_URL=https://replace-with-reviewed-arbitrum-sepolia-rpc
NARYX_SOLANA_DEVNET_RPC_URL=https://replace-with-reviewed-solana-devnet-rpc

# ---------------------------------------------------------------------------
# Browser values (optional; written into web/.env.production as NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------

# Public RPC endpoints for wallet balance reads in the browser bundle. Never put a provider key
# here: every visitor can read them. Unset, the web app uses the public endpoints.
NARYX_WEB_BASE_SEPOLIA_RPC_URL=
NARYX_WEB_ARBITRUM_SEPOLIA_RPC_URL=
NARYX_WEB_SOLANA_DEVNET_RPC_URL=

# The public v1 market API and the package market its chart, book, and solver panels show. Leave
# both empty unless the API runs with NARYX_PUBLIC_MARKET_ENABLED=true behind this HTTPS URL; the
# terminal then shows those panels as not configured, and trading through quotes is unaffected.
NARYX_WEB_PUBLIC_API_BASE_URL=
NARYX_WEB_PACKAGE_MARKET_ID=
