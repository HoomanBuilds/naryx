# services/solver environment. Placeholder values only. Copy this outside the repository, replace the
# placeholders with reviewed values, and never commit a filled-in .env. Keys are never environment
# values: every key is a file outside the repository, referenced by absolute path.
#
# Booleans are exactly true or false; any other value stops the process. Every lane is off unless its
# enable switch is true, and every write or execution switch below is at its safe default.
#
# Every solver listener binds NARYX_SOLVER_HOST, which must be loopback, so every solver endpoint is
# loopback-only. Only services/api on the same host calls them; each lane names the API variable
# that must point at its listener.

# -----------------------------------------------------------------------------------------------------
# Generated values
# -----------------------------------------------------------------------------------------------------
# deployments/tools/release-manifests.mjs writes env/solver.env (output "env/solver.env") from
# deployments/tools/release-common.template.json plus each deployments/*/*/release.template.json passed
# with --release, together with the config files it points at. Run it once per reviewed release and
# start the solver with node --env-file=<out>/env/solver.env dist/main.js. It never reads a key file:
# key paths and addresses come from the operator's filled template, RPC URLs from the generator's own
# environment, database paths from --data-dir, and config paths from --out.
#
# For every network passed, the generator turns that lane on: its quote switch,
# NARYX_SOLANA_DEVNET_SOLVER_ENABLED, and NARYX_ARBITRUM_SEPOLIA_EXECUTOR_ENABLED are written as true.
# NARYX_SOLANA_DEVNET_SOLVER_WRITES_ENABLED is written as false, and
# NARYX_HYPERLIQUID_TESTNET_EXECUTOR_ENABLED is the operator's explicit executionEnabled template value.
# Review every switch in the generated file before starting the process.
#
# Every variable below is generated unless it is marked "not generated".

# -----------------------------------------------------------------------------------------------------
# Core (always read)
# -----------------------------------------------------------------------------------------------------
# Listen host for every solver listener. Default 127.0.0.1. Must be localhost, ::1, or 127.x.x.x.
NARYX_SOLVER_HOST=127.0.0.1
# Quote server port (POST /internal/quotes/atomic-entry). Default 8788. The API calls it through
# NARYX_SOLVER_INTERNAL_ORIGIN (API default http://127.0.0.1:8788). Every lane port must differ.
NARYX_SOLVER_PORT=8788
# API origin the solver calls for orders, selected attempts, and admissions. Default
# http://127.0.0.1:8787 (API default port 8787). Must be a loopback http origin.
NARYX_API_INTERNAL_ORIGIN=http://127.0.0.1:8787
# Required. Ed25519 PKCS8 PEM private key that signs every quote and authorization. Absolute path.
NARYX_SOLVER_ED25519_KEY_PATH=/absolute/path/outside/repository/keys/solver-ed25519.pem
# Optional check. 64 lowercase hex characters of that key's raw public key. If the variable is present,
# even empty, it must match the key or the process stops; delete the line to skip the check.
NARYX_SOLVER_ED25519_PUBLIC_KEY_HEX=replace-with-64-lowercase-hex-public-key
# Required unless NARYX_LOCAL_FIXTURE_MODE=true. Absolute path of the SQLite quote and nonce store.
NARYX_SOLVER_QUOTE_DB=/absolute/path/outside/repository/data/solver/quotes.db

# -----------------------------------------------------------------------------------------------------
# Hyperliquid Testnet quotes (hypercore:testnet)
# -----------------------------------------------------------------------------------------------------
# Signerless. Prices from live l2Book and userFees reads on https://api.hyperliquid-testnet.xyz.
# Default false. When true, the two variables below are required.
NARYX_HYPERLIQUID_TESTNET_QUOTE_ENABLED=false
# Absolute path of protocol JSON {"version": 2, "market": ...}; generated as
# <out>/solver/hyperliquid-testnet-quote.json.
NARYX_HYPERLIQUID_TESTNET_QUOTE_CONFIG=/absolute/path/outside/repository/release/solver/hyperliquid-testnet-quote.json
# Lowercase 0x + 40 hex. Its userFees rates price quotes. Also required by the executor below.
NARYX_HYPERLIQUID_TESTNET_TRADING_ACCOUNT=replace-with-lowercase-testnet-trading-address

# -----------------------------------------------------------------------------------------------------
# Hyperliquid Testnet executor (signs and submits Testnet orders)
# -----------------------------------------------------------------------------------------------------
# Execution switch. Default false. When true the solver opens a second loopback listener
# (POST /internal/solver/hyperliquid-testnet/execute) and every variable in this section, plus
# NARYX_HYPERLIQUID_TESTNET_TRADING_ACCOUNT, is required; a missing or invalid value stops startup.
# The API reaches it only with its own NARYX_HYPERLIQUID_TESTNET_EXECUTOR_CLIENT_ENABLED=true and its
# own NARYX_HYPERLIQUID_TESTNET_EXECUTOR_ORIGIN set to http://127.0.0.1:8792 (no API default origin).
# Keep false until the Testnet account, agent approval, funding, and signer lease are reviewed.
NARYX_HYPERLIQUID_TESTNET_EXECUTOR_ENABLED=false
# Executor port. Default 8792. Must differ from NARYX_SOLVER_PORT.
NARYX_HYPERLIQUID_TESTNET_EXECUTOR_PORT=8792
# not generated. Gates only the reusable executor loader: the solver process ignores this value and
# forces it to true when NARYX_HYPERLIQUID_TESTNET_EXECUTOR_ENABLED=true. Keep false.
NARYX_HYPERLIQUID_TESTNET_EXECUTION_ENABLED=false
# Must be exactly TESTNET.
NARYX_HYPERLIQUID_TESTNET_ENVIRONMENT=TESTNET

# Agent (API wallet) signer. The key file is strict JSON with exactly
# {"version": 1, "environment": "TESTNET", "privateKey": "0x<64 hex>"}: a canonical regular file (no
# symlink) outside the repository, owned by the solver user, mode 0400 or 0600, at most 4096 bytes.
NARYX_HYPERLIQUID_TESTNET_AGENT_KEY_PATH=/absolute/path/outside/repository/keys/hyperliquid-testnet-agent.json
# Lowercase address of that key. It must be the only active agent the master approved, and its
# validUntil must cover each package expiry, recovery deadline, and the incident buffer below.
NARYX_HYPERLIQUID_TESTNET_AGENT_ADDRESS=replace-with-lowercase-testnet-agent-address
# Lowercase master account that approved the agent.
NARYX_HYPERLIQUID_TESTNET_MASTER_ACCOUNT=replace-with-lowercase-testnet-master-address
# MASTER (trading account equals master) or SUBACCOUNT (trading account is a distinct subaccount of the
# master and is sent as the vault address).
NARYX_HYPERLIQUID_TESTNET_ACCOUNT_KIND=SUBACCOUNT
# Stable id of this solver process, 1 to 128 of [A-Za-z0-9._:-], starting alphanumeric. The journal
# binds it to the agent permanently: reuse the same value for the same agent, never for another one.
NARYX_HYPERLIQUID_TESTNET_SIGNER_LEASE_ID=replace-with-stable-signer-lease-id
# Absolute SQLite path outside the working directory (no :memory: or file: URI). Holds the nonce fence,
# submission attempts, and the authority fence state.
NARYX_HYPERLIQUID_TESTNET_JOURNAL_DB=/absolute/path/outside/repository/data/solver/hyperliquid-testnet-journal.db
# Loopback http origin (no path) of the keeper Hyperliquid evidence server. The keeper listens on
# NARYX_KEEPER_PORT, default 8789.
NARYX_HYPERLIQUID_TESTNET_KEEPER_ORIGIN=http://127.0.0.1:8789

# Market qualification, checked against live spotMeta, meta, and both l2Books before any nonce is
# reserved. No defaults. The reviewed Testnet candidate pair is HYPE spot @1035 with HYPE perpetual
# (asset index 135, strict isolated, size decimals 5); re-read every value from the Testnet info API and
# bind it only after live verification. Names are 1 to 64 of [A-Za-z0-9@._:/-].
# Spot pair name in spotMeta.universe, also the spot l2Book coin.
NARYX_HYPERLIQUID_TESTNET_SPOT_UNIVERSE_NAME=@1035
NARYX_HYPERLIQUID_TESTNET_SPOT_TOKEN_NAME=HYPE
NARYX_HYPERLIQUID_TESTNET_QUOTE_TOKEN_NAME=USDC
# Perpetual name in meta.universe, also the perpetual l2Book coin.
NARYX_HYPERLIQUID_TESTNET_PERPETUAL_NAME=HYPE
# true or false, equal to the live isCanonical flag of the spot pair, spot token, and quote token.
NARYX_HYPERLIQUID_TESTNET_SPOT_UNIVERSE_CANONICAL=replace-with-live-isCanonical-true-or-false
NARYX_HYPERLIQUID_TESTNET_SPOT_TOKEN_CANONICAL=replace-with-live-isCanonical-true-or-false
NARYX_HYPERLIQUID_TESTNET_QUOTE_TOKEN_CANONICAL=replace-with-live-isCanonical-true-or-false
# spotMeta tokens[].tokenId, 0x + 32 lowercase hex.
NARYX_HYPERLIQUID_TESTNET_SPOT_TOKEN_ID=replace-with-0x-32-hex-spot-token-id
NARYX_HYPERLIQUID_TESTNET_QUOTE_TOKEN_ID=replace-with-0x-32-hex-quote-token-id
# szDecimals, integer 0 to 18.
NARYX_HYPERLIQUID_TESTNET_SPOT_SIZE_DECIMALS=replace-with-live-spot-szDecimals
NARYX_HYPERLIQUID_TESTNET_PERPETUAL_SIZE_DECIMALS=5
# Maximum book and response age, and maximum spot-to-perpetual book time skew: integer ms, 1 to 60000.
NARYX_HYPERLIQUID_TESTNET_MAX_BOOK_AGE_MS=10000
NARYX_HYPERLIQUID_TESTNET_MAX_BOOK_SNAPSHOT_SKEW_MS=5000
# Maximum divergence between the spot and perpetual midpoints: integer bps, 1 to 10000. Testnet books
# can sit far apart; measure before choosing.
NARYX_HYPERLIQUID_TESTNET_MAX_REFERENCE_DIVERGENCE_BPS=replace-with-measured-bps-1-to-10000
# Positive decimal size in coin units. Required executable depth at the compiled limit price is the
# larger of this value and the planned order size.
NARYX_HYPERLIQUID_TESTNET_MINIMUM_SPOT_DEPTH=replace-with-positive-decimal
NARYX_HYPERLIQUID_TESTNET_MINIMUM_PERPETUAL_DEPTH=replace-with-positive-decimal

# Authority qualification: a signerless inventory of agents, roles, balances, positions. No defaults.
# Added to the agent horizon past package expiry and recovery deadline: integer ms, 1 to 604800000.
NARYX_HYPERLIQUID_TESTNET_AUTHORITY_INCIDENT_BUFFER_MS=604800000
# V1 runs Standard account mode (abstraction disabled), so false.
NARYX_HYPERLIQUID_TESTNET_EXPECTED_PORTFOLIO_MARGIN_ENABLED=false
# cross or isolated; every allowed perpetual must use it. The HYPE candidate is strict isolated.
NARYX_HYPERLIQUID_TESTNET_EXPECTED_LEVERAGE_MODE=isolated
# Unique comma-separated spot token indices that may hold a nonzero balance: the spot base token index
# and the quote token index (USDC, normally 0, and equal to meta.collateralToken).
NARYX_HYPERLIQUID_TESTNET_ALLOWED_SPOT_TOKEN_INDICES=replace-with-spot-token-index,0
# Unique comma-separated perpetual coins. The trading account must have an active asset mode for
# exactly these coins and no position in any other.
NARYX_HYPERLIQUID_TESTNET_ALLOWED_PERPETUAL_COINS=HYPE
# Maximum age of the authority inventory and of an incident clearance read: integer ms, 1 to 60000.
NARYX_HYPERLIQUID_TESTNET_MAX_AUTHORITY_SNAPSHOT_AGE_MS=30000
NARYX_HYPERLIQUID_TESTNET_MAX_AUTHORITY_CLEARANCE_AGE_MS=30000

# -----------------------------------------------------------------------------------------------------
# Solana Devnet firm quotes and attempt binding (svm:devnet)
# -----------------------------------------------------------------------------------------------------
# Default false. When true: FIRM_ONCHAIN quotes for svm:devnet orders plus a loopback listener
# (/internal/solana-devnet/attempt-binding and /internal/solana-devnet/release-reservation). The API
# calls it through NARYX_SOLANA_DEVNET_BINDING_ORIGIN=http://127.0.0.1:8795 (the API has no default).
# Startup requires the Devnet genesis hash and the reviewed program identities read from chain.
NARYX_SOLANA_DEVNET_SOLVER_ENABLED=false
# Write switch. Default false. true lets the solver send Devnet transactions (package book level,
# reservation funding, quote lock, reservation release); the genesis hash is re-read before each write.
NARYX_SOLANA_DEVNET_SOLVER_WRITES_ENABLED=false
# Absolute path of the schemaVersion 1 solver config, generated as
# <out>/solver/solana-devnet-solver.json. Its runtimeManifestPath names the API's Devnet runtime manifest.
NARYX_SOLANA_DEVNET_SOLVER_CONFIG=/absolute/path/outside/repository/release/solver/solana-devnet-solver.json
# Solana CLI keypair file (64-byte JSON array) outside the repository with mode 600. Its public key
# must equal the config solverId.
NARYX_SOLANA_DEVNET_SOLVER_KEYPAIR_PATH=/absolute/path/outside/repository/keys/solana-devnet-solver.json
# HTTPS RPC (plain http only for 127.0.0.1 or localhost). No default.
NARYX_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
# Binding listener port. Default 8795. Must differ from NARYX_SOLVER_PORT.
NARYX_SOLANA_DEVNET_BINDING_PORT=8795
# Absolute SQLite path outside the repository for issued firm quotes and lock arguments.
NARYX_SOLANA_DEVNET_SOLVER_JOURNAL_DB=/absolute/path/outside/repository/data/solver/solana-devnet-journal.db

# -----------------------------------------------------------------------------------------------------
# Base Sepolia quotes and solver authorization listener (eip155:84532)
# -----------------------------------------------------------------------------------------------------
# Default false. This one switch enables both live Base quotes and the loopback solver authorization
# listener (POST /internal/base-sepolia/solver-authorizations), which co-signs the PackageVerifier
# SolverAuthorization offchain for a selected attempt and never broadcasts. The API calls it through
# NARYX_BASE_SEPOLIA_SOLVER_ORIGIN (API default http://127.0.0.1:8794). When true, every variable
# below is required and eth_chainId must be 84532.
NARYX_BASE_SEPOLIA_QUOTE_ENABLED=false
# Absolute path of the API's Base runtime manifest (schemaVersion 1, ACTIVE); generated as
# <out>/api/base-sepolia-runtime.json.
NARYX_BASE_SEPOLIA_RUNTIME_MANIFEST=/absolute/path/outside/repository/release/api/base-sepolia-runtime.json
# Absolute path of protocol JSON {"version": 1, "market": ...}; generated as
# <out>/solver/base-sepolia-quote.json.
NARYX_BASE_SEPOLIA_QUOTE_CONFIG=/absolute/path/outside/repository/release/solver/base-sepolia-quote.json
# http or https URL. Reviewed provider; may carry a provider key, so keep the env file private.
NARYX_BASE_SEPOLIA_RPC_URL=https://replace-with-reviewed-base-sepolia-rpc
# Key file is strict JSON {"version": 1, "environment": "BASE_SEPOLIA", "privateKey": "0x<64 hex>"}: a
# canonical regular file owned by the solver user, no group or other permission bits, at most 512 bytes.
NARYX_BASE_SEPOLIA_SOLVER_KEY_PATH=/absolute/path/outside/repository/keys/base-sepolia-solver.json
# Address of that key; must also equal the manifest executionPolicy.solver.
NARYX_BASE_SEPOLIA_SOLVER_ADDRESS=replace-with-base-sepolia-solver-address
# Authorization listener port. Default 8794. Must differ from NARYX_SOLVER_PORT.
NARYX_BASE_SEPOLIA_SOLVER_AUTHORIZATION_PORT=8794

# -----------------------------------------------------------------------------------------------------
# Arbitrum Sepolia quotes and executor (eip155:421614)
# -----------------------------------------------------------------------------------------------------
# Default false. Live reference feed price and GMX fee factors read on chain. When true,
# NARYX_ARBITRUM_SEPOLIA_QUOTE_CONFIG and NARYX_ARBITRUM_SEPOLIA_RPC_URL are required.
NARYX_ARBITRUM_SEPOLIA_QUOTE_ENABLED=false
# Absolute path of protocol JSON {"version": 1, "market": ...}; generated as
# <out>/solver/arbitrum-sepolia-quote.json.
NARYX_ARBITRUM_SEPOLIA_QUOTE_CONFIG=/absolute/path/outside/repository/release/solver/arbitrum-sepolia-quote.json
# http or https URL shared by quotes and the executor. Reviewed provider; keep the env file private.
NARYX_ARBITRUM_SEPOLIA_RPC_URL=https://replace-with-reviewed-arbitrum-sepolia-rpc
# Write switch. Default false. true opens a loopback listener (/internal/solver/arbitrum-sepolia/
# prepare, authorize, execute) that sends Arbitrum Sepolia transactions with the solver key, only after
# eth_chainId == 421614. Only the solver key is loaded; owners sign in their own wallets. The API calls
# it only with its own NARYX_ARBITRUM_SEPOLIA_EXECUTOR_CLIENT_ENABLED=true and its own
# NARYX_ARBITRUM_SEPOLIA_EXECUTOR_ORIGIN set to http://127.0.0.1:8793 (no API default origin).
# When true, every variable below is required.
NARYX_ARBITRUM_SEPOLIA_EXECUTOR_ENABLED=false
# Executor port. Default 8793. Must differ from NARYX_SOLVER_PORT and the Hyperliquid executor port.
NARYX_ARBITRUM_SEPOLIA_EXECUTOR_PORT=8793
# Absolute path of the version 1 executor config; generated as <out>/solver/arbitrum-sepolia-executor.json.
NARYX_ARBITRUM_SEPOLIA_EXECUTOR_CONFIG=/absolute/path/outside/repository/release/solver/arbitrum-sepolia-executor.json
# Absolute SQLite path outside the repository for execution plans and sent transactions.
NARYX_ARBITRUM_SEPOLIA_EXECUTOR_DB=/absolute/path/outside/repository/data/solver/arbitrum-sepolia-executor.db
# Key file is strict JSON {"version": 1, "environment": "ARBITRUM_SEPOLIA", "privateKey": "0x<64 hex>"}:
# a canonical regular file outside the repository, owned by the solver user, mode 0400 or 0600.
NARYX_ARBITRUM_SEPOLIA_SOLVER_KEY_PATH=/absolute/path/outside/repository/keys/arbitrum-sepolia-solver.json
# Lowercase address of that key (the bonded solver).
NARYX_ARBITRUM_SEPOLIA_SOLVER_ADDRESS=replace-with-lowercase-bonded-solver-address

# -----------------------------------------------------------------------------------------------------
# Local development only
# -----------------------------------------------------------------------------------------------------
# WARNING: never set any variable in this section in a Devnet, testnet, or any other deployment.
#
# not generated. Default false. true composes the fixed-price local fixture catalog (placeholder hashes,
# signed with the solver key) and lets NARYX_SOLVER_QUOTE_DB fall back to
# /tmp/naryx-local/solver-quotes.db. Cannot be combined with NARYX_SOLANA_LOCAL_ENVIRONMENT_MANIFEST.
NARYX_LOCAL_FIXTURE_MODE=false
# Local Solana conformance runtime against a local validator. It is on only when
# NARYX_SOLANA_LOCAL_ENVIRONMENT_MANIFEST is non-empty; leave all three commented out otherwise.
# not generated. Absolute path of the local environment manifest.
# NARYX_SOLANA_LOCAL_ENVIRONMENT_MANIFEST=/absolute/path/outside/repository/local/local-environment-manifest.json
# not generated. Required with the manifest. Absolute SQLite path for local execution authorizations.
# NARYX_SOLVER_SOLANA_AUTHORIZATION_DB=/absolute/path/outside/repository/local/solver-solana-authorizations.db
# not generated. Required with the manifest. Base58 solver id the local manifest names.
# NARYX_SOLANA_LOCAL_SOLVER_ID=replace-with-local-solver-id
