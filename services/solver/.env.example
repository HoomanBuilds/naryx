NARYX_SOLVER_HOST=127.0.0.1
NARYX_SOLVER_PORT=8788
NARYX_API_INTERNAL_ORIGIN=http://127.0.0.1:8787
NARYX_SOLVER_ED25519_KEY_PATH=/absolute/external/path/to/solver-ed25519-key.json
NARYX_SOLVER_ED25519_PUBLIC_KEY_HEX=replace-with-public-key-hex
NARYX_SOLVER_QUOTE_DB=/absolute/external/path/to/solver-quotes.sqlite

# Static local fixture catalog with fixed prices. Opt-in only; never combine with a manifest.
NARYX_LOCAL_FIXTURE_MODE=false

NARYX_SOLVER_SOLANA_AUTHORIZATION_DB=/absolute/external/path/to/solver-solana-authorizations.sqlite
NARYX_SOLANA_LOCAL_SOLVER_ID=replace-with-solver-id
NARYX_SOLANA_LOCAL_ENVIRONMENT_MANIFEST=/absolute/path/to/local-environment-manifest.json

# Live Testnet l2Book and userFees pricing; also requires NARYX_HYPERLIQUID_TESTNET_TRADING_ACCOUNT.
NARYX_HYPERLIQUID_TESTNET_QUOTE_ENABLED=false
NARYX_HYPERLIQUID_TESTNET_QUOTE_CONFIG=/absolute/path/to/version-2-hyperliquid-testnet-quote-config.json

NARYX_HYPERLIQUID_TESTNET_EXECUTION_ENABLED=false
NARYX_HYPERLIQUID_TESTNET_EXECUTOR_ENABLED=false
NARYX_HYPERLIQUID_TESTNET_EXECUTOR_PORT=8792
NARYX_HYPERLIQUID_TESTNET_ENVIRONMENT=TESTNET
NARYX_HYPERLIQUID_TESTNET_AGENT_ADDRESS=replace-with-lowercase-testnet-agent-address
NARYX_HYPERLIQUID_TESTNET_AGENT_KEY_PATH=/absolute/external/path/to/hyperliquid-testnet-agent.json
NARYX_HYPERLIQUID_TESTNET_SIGNER_LEASE_ID=replace-with-stable-solver-process-lease
NARYX_HYPERLIQUID_TESTNET_MASTER_ACCOUNT=replace-with-lowercase-testnet-master-address
NARYX_HYPERLIQUID_TESTNET_TRADING_ACCOUNT=replace-with-lowercase-testnet-trading-address
NARYX_HYPERLIQUID_TESTNET_ACCOUNT_KIND=SUBACCOUNT
NARYX_HYPERLIQUID_TESTNET_JOURNAL_DB=/absolute/external/path/to/hyperliquid-testnet.sqlite
NARYX_HYPERLIQUID_TESTNET_KEEPER_ORIGIN=http://127.0.0.1:8791

# Arbitrum Sepolia async entry. Quotes use a live reference feed and GMX fee factors read on chain.
NARYX_ARBITRUM_SEPOLIA_QUOTE_ENABLED=false
NARYX_ARBITRUM_SEPOLIA_QUOTE_CONFIG=/absolute/path/to/version-1-arbitrum-sepolia-quote-config.json
NARYX_ARBITRUM_SEPOLIA_RPC_URL=https://replace-with-reviewed-arbitrum-sepolia-rpc
# Executor: writes only after eth_chainId == 421614; solver and owner keys are separate external files.
NARYX_ARBITRUM_SEPOLIA_EXECUTOR_ENABLED=false
NARYX_ARBITRUM_SEPOLIA_EXECUTOR_PORT=8793
NARYX_ARBITRUM_SEPOLIA_EXECUTOR_CONFIG=/absolute/path/to/version-1-arbitrum-sepolia-executor-config.json
NARYX_ARBITRUM_SEPOLIA_EXECUTOR_DB=/absolute/external/path/to/arbitrum-sepolia-executor.sqlite
NARYX_ARBITRUM_SEPOLIA_SOLVER_ADDRESS=replace-with-lowercase-bonded-solver-address
NARYX_ARBITRUM_SEPOLIA_SOLVER_KEY_PATH=/absolute/external/path/to/arbitrum-sepolia-solver-key.json
