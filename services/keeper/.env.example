# services/keeper configuration. Placeholder values only; never commit a filled-in .env.
# Load with `node --env-file=<file> dist/main.js` or a systemd EnvironmentFile. Every path must be
# absolute and outside the repository checkout. Every optional feature is off while its variable is
# unset or empty, and no variable here enables a mainnet write.

# ---------------------------------------------------------------------------
# Generated values
# ---------------------------------------------------------------------------
# After a reviewed testnet deployment, deployments/tools/release-manifests.mjs writes env/keeper.env
# from deployments/tools/release-common.template.json and every deployments/*/*/release.template.json
# passed with --release (see deployments/tools/README.md), merging the networks into one file:
# - common: NARYX_KEEPER_HOST, NARYX_KEEPER_PORT, and NARYX_KEEPER_RPC_URLS.
# - base-sepolia, arbitrum-sepolia, solana-devnet: their NARYX_KEEPER_RPC_URLS entry and
#   NARYX_CODE_WATCHLIST (one merged keeper/code-watchlist.json).
# - base-sepolia, solana-devnet: NARYX_FUNDING_MIRROR_CONFIG, NARYX_FUNDING_MIRROR_WRITES=disabled,
#   and that chain's funding keeper key file path (empty while writes stay disabled).
# Variables marked "not generated" are set by hand, only when that feature is wanted.

# ---------------------------------------------------------------------------
# Evidence listener (always on)
# ---------------------------------------------------------------------------
# Serves the Hyperliquid Testnet evidence routes under /internal/keeper/hyperliquid-testnet/.
# Host: loopback only (127.x.x.x, localhost, or ::1); any other host fails startup. Default 127.0.0.1.
# Port: integer 1 to 65535. Default 8789.
# Unset uses the default, but an empty value fails startup: remove the line instead of blanking it.
NARYX_KEEPER_HOST=127.0.0.1
NARYX_KEEPER_PORT=8789

# ---------------------------------------------------------------------------
# Read-only RPC
# ---------------------------------------------------------------------------
# One read-only RPC URL per chain reference, as a single-quoted, single-line JSON object.
# Keys: eip155:<decimal chain id>, solana:devnet, or solana:mainnet-beta (read-only); any other key
# fails startup. URLs: https, or http to 127.0.0.1, localhost, or [::1]. A URL may carry a provider
# key, so it never appears in an error or log line. Every read first proves the chain from chain data
# (eth_chainId, or the Solana genesis hash), never from this label.
# Default: empty map. Parsed only when the code-hash monitor, funding mirror, or keeper automation
# is on, and each of them needs a URL for every chain it reads; a missing entry fails startup.
# The solana:devnet URL is also the keeper automation SOLANA_SLOT clock (getSlot at confirmed
# commitment); without it, SOLANA_SLOT authorizations stay NOT_READY.
NARYX_KEEPER_RPC_URLS='{"eip155:84532":"https://replace-with-reviewed-base-sepolia-rpc","eip155:421614":"https://replace-with-reviewed-arbitrum-sepolia-rpc","solana:devnet":"https://replace-with-reviewed-solana-devnet-rpc"}'

# ---------------------------------------------------------------------------
# Code-hash monitor (read-only)
# ---------------------------------------------------------------------------
# Compares live code hashes with reviewed ones and quarantines a scope in its incident journal on
# DRIFT or MISSING. Holds no key and never writes to a chain. Off while empty.
# Path of a protocol-JSON watchlist, e.g. /absolute/path/outside/repository/keeper/code-watchlist.json:
# intervalMs (at least 5000), evidenceTtlMs (positive bigint), targets (1 to 256 of targetId,
# scopeId, chainRef, address, expectedCodeHash), journals (absolute journalPath and readinessDecision).
# Every target's chainRef needs its URL in NARYX_KEEPER_RPC_URLS.
NARYX_CODE_WATCHLIST=

# ---------------------------------------------------------------------------
# Funding mirror
# ---------------------------------------------------------------------------
# Reads Hyperliquid mainnet funding (pinned signerless Info API, no URL override) and sets the
# mirrored rate on the Naryx test perps on Base Sepolia (eip155:84532) and Solana Devnet
# (solana:devnet). Every pass verifies eth_chainId or the genesis hash first. Off while empty.
# Absolute path of a JSON config, e.g. /absolute/path/outside/repository/keeper/funding-mirror.json:
# intervalMs (at least 60000), recordPath (absolute), markets (id, chainRef, market, programId for
# Solana, coin, minChange). Every market's chainRef needs its URL in NARYX_KEEPER_RPC_URLS.
NARYX_FUNDING_MIRROR_CONFIG=
# Write switch. Only the exact value "enabled" signs and submits; anything else, unset, or empty is a
# dry run that reads, converts, and logs. Keep it disabled until a reviewed testnet go-live step.
NARYX_FUNDING_MIRROR_WRITES=disabled
# Funding keeper key files, outside the repository. Read only when writes are enabled, and then
# required for each chain that has a market (startup fails otherwise); the loaded key must be that
# market's funding keeper. A non-empty value must be absolute even while writes are disabled.
# EVM: a file holding one 0x-prefixed 32-byte hex key, e.g.
# /absolute/path/outside/repository/keys/funding-keeper-evm.key
# Solana: a Solana CLI JSON keypair file (64 bytes), e.g.
# /absolute/path/outside/repository/keys/funding-keeper-solana.json
NARYX_FUNDING_KEEPER_EVM_KEY_FILE=
NARYX_FUNDING_KEEPER_SOLANA_KEY_FILE=

# ---------------------------------------------------------------------------
# Keeper automation (not generated)
# ---------------------------------------------------------------------------
# Dispatches owner-signed, kernel-approved keeper actions to a loopback executor (the API private
# server's /internal/keeper/ routes), consuming each authorization's nonce once in its journal. The
# keeper holds no trading key. There is no separate write switch: a set path turns dispatch on.
# Off while empty.
# not generated. Absolute path of a protocol-JSON config, e.g.
# /absolute/path/outside/repository/keeper/keeper-automation.json: keeperId, executorOrigin
# (http://127.0.0.1 or http://localhost, optional port), intervalMs (at least 5000), journalPath
# (absolute), entries (1 to 256 owner-signed authorizations).
NARYX_KEEPER_AUTOMATION_CONFIG=

# ---------------------------------------------------------------------------
# HyperCore testnet position snapshots (not generated)
# ---------------------------------------------------------------------------
# Reads HyperCore testnet accounts, signs each snapshot hash, and posts it to
# <apiBaseUrl>/v1/position-snapshots, where the API verifies it. Off while the watchlist is empty.
# not generated. Path of a protocol-JSON watchlist, e.g.
# /absolute/path/outside/repository/keeper/position-watchlist.json: intervalMs (at least 5000),
# environment (any id except mainnet), apiBaseUrl (https, or loopback http), authority (signing key
# id), accounts (1 to 64).
NARYX_POSITION_WATCHLIST=
# not generated. Required when the watchlist is set (startup fails without it); ignored otherwise.
# Absolute path of the Ed25519 PKCS#8 PEM key that signs observations only and holds no account
# authority, e.g. /absolute/path/outside/repository/keys/position-authority-ed25519.pem
NARYX_POSITION_AUTHORITY_KEY_FILE=
