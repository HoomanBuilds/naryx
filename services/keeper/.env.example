# Loopback evidence service.
NARYX_KEEPER_HOST=127.0.0.1
NARYX_KEEPER_PORT=8789

# One read-only RPC URL per chain reference, as a single-line JSON object. Every read first
# verifies the chain from chain data (eth_chainId, or the Solana genesis hash), never from this
# label. Keys: eip155:<chain id>, solana:devnet, solana:mainnet-beta. URLs: https, or loopback http.
# The solana:devnet URL is also the keeper's SOLANA_SLOT clock (confirmed commitment).
NARYX_KEEPER_RPC_URLS='{"eip155:84532":"https://replace-with-reviewed-base-sepolia-rpc","eip155:421614":"https://replace-with-reviewed-arbitrum-sepolia-rpc","solana:devnet":"https://replace-with-reviewed-solana-devnet-rpc"}'

# Each feature below is off while its variable is empty.
# Code-hash monitor watchlist, e.g. /absolute/path/to/code-watchlist.json; every target names its chainRef.
NARYX_CODE_WATCHLIST=
# Keeper automation config, e.g. /absolute/path/to/keeper-automation.json.
NARYX_KEEPER_AUTOMATION_CONFIG=
# HyperCore testnet position snapshots, e.g. /absolute/path/to/position-watchlist.json and
# /absolute/external/path/to/position-authority-ed25519.pem.
NARYX_POSITION_WATCHLIST=
NARYX_POSITION_AUTHORITY_KEY_FILE=
