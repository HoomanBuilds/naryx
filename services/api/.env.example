# services/api configuration. Placeholder values only; never commit a filled-in .env.
# The API does not read a .env file by itself: load one with `node --env-file=<file> dist/main.js`
# or a systemd EnvironmentFile. Comments stay on their own lines, because an EnvironmentFile keeps
# an inline "# ..." as part of the value.
#
# Every path must be absolute. Keep every database, config, and key file outside the repository
# checkout (the execution policy file and its database refuse a path inside it).
# Every *_ENABLED switch and NARYX_LOCAL_FIXTURE_MODE default to false and accept only true or
# false; any other value fails startup.
#
# Startup fails on: an invalid host, port, or origin; a missing core store path; a malformed
# switch; a half-set or invalid execution policy; and any public market API configuration error.
# An enabled testnet lane that cannot compose (bad path, unreachable RPC, wrong chain, code hash
# mismatch) does not stop the process: it logs "Naryx API runtime <name> failed to initialize" to
# stderr and GET /internal/healthz reports status "degraded" with the lane's reason.

# ---------------------------------------------------------------------------
# Generated values
# ---------------------------------------------------------------------------
# deployments/tools/release-manifests.mjs writes env/api.env with most of these values from the
# reviewed release templates: the "env/api.env" output of
# deployments/tools/release-common.template.json and of each deployments/*/*/release.template.json
# passed to it. It also writes the runtime manifests, order contexts, and execution policy those
# values point at, and validates them with the API's own loaders. Prefer that generated file.
# A variable marked "# not generated" is never written by the generator; add it by hand when you
# need it. See deployments/tools/README.md.

# ---------------------------------------------------------------------------
# (a) Required for any real testnet operation
# ---------------------------------------------------------------------------

# Private terminal listener. Default 127.0.0.1:8787. A non-loopback host fails startup (see the
# local development section). Keep it on loopback behind a TLS reverse proxy. A proxy on the same
# host makes every caller look loopback, so forward only /internal/terminal/ (and /v1/ when the
# public API shares this listener); never forward /internal/solver/, /internal/keeper/,
# /internal/coordination/, or /internal/recovery/.
NARYX_API_HOST=127.0.0.1
NARYX_API_PORT=8787

# Exact HTTP(S) origin of the web terminal: scheme, host, optional port, no path or trailing slash.
# Unset, every browser request (anything carrying an Origin header) is refused with 403
# ORIGIN_NOT_ALLOWED, so the terminal cannot reach the API. The generator takes it from an
# operator-filled template value.
NARYX_TERMINAL_ORIGIN=https://replace-with-reviewed-terminal-origin

# Durable stores. Startup fails and names the missing variable when any is unset, unless
# NARYX_LOCAL_FIXTURE_MODE=true.
NARYX_API_ORDER_DB=/absolute/path/outside/repository/api-orders.db
NARYX_API_LIFECYCLE_DB=/absolute/path/outside/repository/package-lifecycle.db
NARYX_API_EXECUTION_INTENT_DB=/absolute/path/outside/repository/execution-intents.db

# Loopback solver internal API used for order quotes and local execution authorization: an
# http:// origin on localhost, 127.x.x.x, or [::1], no path. Default http://127.0.0.1:8788 (the
# solver's own default port). Any other value fails startup.
NARYX_SOLVER_INTERNAL_ORIGIN=http://127.0.0.1:8788
# Enables the private terminal's unsigned generalized strategy preparation proxy. The solver must
# enable at least one reviewed preparation lane, and the public-market runtime must configure
# NARYX_STRATEGY_PACKAGE_DB. This does not sign or broadcast.
NARYX_GENERALIZED_STRATEGY_PREPARATION_ENABLED=false

# Testnet execution approval. Set both or neither; one alone fails startup. Without both, every
# execution handoff is refused with 503 READINESS_UNAVAILABLE and no lane reports execution as
# available. Both paths must be outside the repository, and the policy cannot run alongside
# NARYX_LOCAL_FIXTURE_MODE=true.
# The policy file lists each enabled testnet domain (svm:devnet, eip155:84532, eip155:421614,
# hypercore:testnet) with caps in its quote asset's atoms, as decimal strings. Every trade is
# bounded per operation; the daily brakes maxPrincipalAtomsPerDay (per domain) and
# maxPrincipalAtomsPerOwnerPerDay (per wallet) are optional and off when absent, where
# 0 < per operation <= per wallet per day <= per day:
# {"version":1,"domains":[{"domainId":"hypercore:testnet","quoteAssetId":"<order quote asset id>",
#   "maxPrincipalAtomsPerOperation":"250000000","maxRecoveryLossAtomsPerOperation":"25000000"}]}
# "domains" must not be empty. The file is validated at startup and re-read on every decision, so
# cap changes apply without a restart. Mainnet domains are refused regardless of its contents.
# Every allow and deny is recorded in the decision database.
NARYX_EXECUTION_POLICY_FILE=/absolute/path/outside/repository/testnet-execution-policy.json
NARYX_EXECUTION_POLICY_DB=/absolute/path/outside/repository/testnet-execution-decisions.db

# ---------------------------------------------------------------------------
# (b) Testnet lanes
# ---------------------------------------------------------------------------
# Each lane verifies network identity from chain data (genesis hash or eth_chainId), never from the
# RPC URL. RPC URLs are read-only and may carry a provider key, so keep the filled file private.
# A lane reports execution available only when its runtime composed and the execution policy
# above is set.

# --- Solana Devnet (domain svm:devnet) ---
# Execution lane. When true, the manifest, RPC URL, preparation database, and binding origin are
# all required; a missing or invalid one reports the lane degraded.
NARYX_SOLANA_DEVNET_RUNTIME_ENABLED=false
NARYX_SOLANA_DEVNET_RUNTIME_MANIFEST=/absolute/path/to/solana-devnet-runtime.json
# HTTPS (plain http is accepted only on 127.0.0.1 or localhost).
NARYX_SOLANA_DEVNET_RPC_URL=https://replace-with-reviewed-solana-devnet-rpc
NARYX_SOLANA_DEVNET_PREPARATION_DB=/absolute/path/outside/repository/api-solana-devnet-preparations.db
# The solver's loopback attempt-binding listener (solver default port 8795). No default here; it
# must be http://127.0.0.1:<port> or http://localhost:<port>.
NARYX_SOLANA_DEVNET_BINDING_ORIGIN=http://127.0.0.1:8795
# Entry path, independent of the execution switch: live Pyth SOL/USD order context, per-wallet
# onboarding reads at GET /internal/terminal/solana-devnet/account?owner=<wallet>&sizeAtoms=<atoms>,
# exit-order construction, the Solana terminal snapshot and preview market, and FIRM_ONCHAIN quote
# verification. Reads chain only; uses NARYX_SOLANA_DEVNET_RUNTIME_MANIFEST and
# NARYX_SOLANA_DEVNET_RPC_URL above. If it fails to load it is logged and left off.
NARYX_SOLANA_DEVNET_ORDER_CONTEXT_ENABLED=false
NARYX_SOLANA_DEVNET_ORDER_CONTEXT=/absolute/path/to/solana-devnet-order-context.json

# --- Base Sepolia (domain eip155:84532) ---
# Atomic lane with its entry path: live pool and oracle prices, the Base terminal snapshot and
# preview market, and per-wallet account status; any wallet trades through its own factory
# account. There is no separate order context switch: when true, every value below is required,
# and a missing or failing order context reports the whole lane degraded. Chain id and contract
# code hashes are checked against the manifest at startup.
NARYX_BASE_TESTNET_RUNTIME_ENABLED=false
NARYX_BASE_SEPOLIA_RUNTIME_MANIFEST=/absolute/path/to/base-sepolia-runtime.json
NARYX_BASE_SEPOLIA_ORDER_CONTEXT=/absolute/path/to/base-sepolia-order-context.json
# HTTP or HTTPS.
NARYX_BASE_SEPOLIA_RPC_URL=https://replace-with-reviewed-base-sepolia-rpc
# Keeps prepared attempts, bound transaction hashes, and each transaction's observed outcome across restarts.
NARYX_BASE_SEPOLIA_PREPARATION_DB=/absolute/path/outside/repository/api-base-sepolia-preparations.db
# The solver's loopback Base authorization listener. Default http://127.0.0.1:8794.
NARYX_BASE_SEPOLIA_SOLVER_ORIGIN=http://127.0.0.1:8794

# --- Arbitrum Sepolia (domain eip155:421614) ---
# Async bonded-solver lane. When true, the manifest and RPC URL are required.
NARYX_ARBITRUM_TESTNET_RUNTIME_ENABLED=false
NARYX_ARBITRUM_SEPOLIA_RUNTIME_MANIFEST=/absolute/path/to/arbitrum-sepolia-runtime.json
# HTTP or HTTPS.
NARYX_ARBITRUM_SEPOLIA_RPC_URL=https://replace-with-reviewed-arbitrum-sepolia-rpc
# Entry path, independent of the execution switch: live on-chain reference price; any wallet
# trades through its own factory account. Uses the manifest and RPC URL above. Without it no
# Arbitrum order can be priced. The terminal snapshot and preview have no Arbitrum market source
# and answer 503 DOMAIN_MARKET_UNAVAILABLE for this domain either way.
NARYX_ARBITRUM_SEPOLIA_ORDER_CONTEXT_ENABLED=false
NARYX_ARBITRUM_SEPOLIA_ORDER_CONTEXT=/absolute/path/to/arbitrum-sepolia-order-context.json
# Takes effect only with NARYX_ARBITRUM_TESTNET_RUNTIME_ENABLED=true. The gated observe-async
# handoff first advances the solver-held coordinator steps in the solver's loopback Arbitrum
# executor, and the owner routes let the browser wallet sign the reservation itself. A missing or
# non-loopback executor origin reports the whole Arbitrum lane degraded.
NARYX_ARBITRUM_SEPOLIA_EXECUTOR_CLIENT_ENABLED=false
# Loopback http:// origin of the solver's Arbitrum executor (solver default port 8793). No default.
NARYX_ARBITRUM_SEPOLIA_EXECUTOR_ORIGIN=http://127.0.0.1:8793
# Required with the executor client: keeps each attempt's observed outcome across restarts for the
# owner's package list. Missing, the Arbitrum lane reports degraded.
NARYX_ARBITRUM_SEPOLIA_OUTCOME_DB=/absolute/path/outside/repository/api-arbitrum-sepolia-outcomes.db

# --- Hyperliquid Testnet (domain hypercore:testnet) ---
# No Naryx contract; the solver executes. The lane reports execution available only when all
# three switches are true. With the runtime switch alone, the order context and terminal market
# load but /internal/healthz reports the lane RUNTIME_FACTORY_NOT_INJECTED.
NARYX_HYPERLIQUID_TESTNET_RUNTIME_ENABLED=false
NARYX_HYPERLIQUID_TESTNET_EVIDENCE_ENABLED=false
NARYX_HYPERLIQUID_TESTNET_EXECUTOR_CLIENT_ENABLED=false
# Must be exactly TESTNET when the runtime is enabled; anything else reports the lane degraded.
NARYX_HYPERLIQUID_TESTNET_ENVIRONMENT=TESTNET
# An orderContext in the runtime config prices orders from read-only requests to the pinned
# Testnet info endpoint; its livePricing bounds refresh, book age, spread, recovery band, and fee
# slack. The same feed is the Hyperliquid terminal snapshot and preview source.
NARYX_HYPERLIQUID_TESTNET_RUNTIME_CONFIG=/absolute/path/to/hyperliquid-testnet-runtime.json
# Required with the evidence switch: a loopback http:// origin, no default. Point it at the
# keeper's Hyperliquid evidence server (keeper default port 8789).
NARYX_HYPERLIQUID_TESTNET_EVIDENCE_ORIGIN=http://127.0.0.1:8789
# Required with the executor client switch: the solver's loopback Hyperliquid executor (solver
# default port 8792), no default, and the durable journal of executor handoffs.
NARYX_HYPERLIQUID_TESTNET_EXECUTOR_ORIGIN=http://127.0.0.1:8792
NARYX_API_HYPERLIQUID_TESTNET_EXECUTION_DB=/absolute/path/outside/repository/api-hyperliquid-testnet-executions.db

# --- Reference history (every lane above) ---
# Optional durable store of each composed lane's live market source: every 15 seconds the API
# records the spot and perp reference mids, the basis, and the exact source of each leg, only while
# that source is fresh, and keeps 30 days. The web chart reads it from
# GET /internal/terminal/reference-candles. Set to record and serve it; unset, the route answers
# 404 and the chart shows no reference history. A path that cannot open logs why and leaves the
# history off; trading is unaffected.
NARYX_REFERENCE_HISTORY_DB=/absolute/path/outside/repository/reference-history.db

# ---------------------------------------------------------------------------
# (c) Public market API: the /v1 routes and /v1/stream WebSocket the web chart and book read
# ---------------------------------------------------------------------------
# Optional and not generated: the release generator leaves the public market off, and quote-based
# trading does not need it. To run it, set these by hand, serve the public listener behind its own
# HTTPS URL, and pass that URL as NARYX_WEB_PUBLIC_API_BASE_URL when generating the web env.
# Off unless exactly true; every other public variable is ignored while it is false. When true,
# the exchange database and support manifest are required, and any error in this section or in
# section (d) fails startup. Public routes serve reads and computation. The explicit strategy
# package submission route persists only when NARYX_STRATEGY_PACKAGE_DB is configured.
# The web app reads /v1/markets/<id>/package-depth, /v1/markets/<id>/package-tape, and /v1/stream
# (exchange database), /v1/solvers (registry), and /v1/analytics/execution-quality (evidence).
# A route whose store is not configured answers 503.
NARYX_PUBLIC_MARKET_ENABLED=false
NARYX_EXCHANGE_DB=/absolute/path/outside/repository/exchange.db
# Protocol JSON, at most 64 KiB: version 1, clockUnit (UNIX_SECONDS or UNIX_MILLISECONDS),
# seriesSupport, executionClassSupport, and optionally backingAtomsPerPackageUnit.
NARYX_EXCHANGE_SUPPORT_MANIFEST=/absolute/path/to/exchange-support.json
# Dedicated public listener. With a port set, /v1 runs on its own server (CORS open to any origin)
# that never serves /internal routes. The host must be an IP address (default 127.0.0.1); it is
# not limited to loopback, so 0.0.0.0 exposes it. A host without a port fails startup, even an
# empty one. Leave both unset to serve /v1 on the private listener under NARYX_TERMINAL_ORIGIN.
NARYX_PUBLIC_API_HOST=127.0.0.1
NARYX_PUBLIC_API_PORT=8790
# Registry routes, including /v1/solvers; required by the solver API.
NARYX_REGISTRY_DB=/absolute/path/outside/repository/registry.db
# Order intake, order and receipt reads, and execution analytics; required by the strategy and
# builder stores.
NARYX_EVIDENCE_DB=/absolute/path/outside/repository/evidence.db
# Requests per minute per client for the public and solver APIs: 1 to 10000, default 120.
# not generated
# NARYX_PUBLIC_MARKET_REQUESTS_PER_MINUTE=120

# ---------------------------------------------------------------------------
# (d) Optional stores and advanced features (only with NARYX_PUBLIC_MARKET_ENABLED=true)
# ---------------------------------------------------------------------------
# Each is off while unset; a set value that is invalid, or that lacks what it depends on, fails
# startup. Authority lists are comma-separated keyId:base58 Ed25519 public keys, where keyId
# matches [A-Za-z0-9._-]{1,128}.

# Non-mainnet environment id ([A-Za-z0-9._:-]{1,64}). Required by NARYX_STRATEGY_DB,
# NARYX_BUILDER_DB, NARYX_COORDINATION_DB, and NARYX_CATALOGUE_KEY_FILE.
# not generated
# NARYX_PUBLIC_ENVIRONMENT=testnet

# Durable generalized strategy-package intake. Requires NARYX_REGISTRY_DB and
# NARYX_GRAPH_COMPILE_CONTEXT. The admitted package is readable only through the private
# loopback route used by the solver.
# not generated
# NARYX_STRATEGY_PACKAGE_DB=/absolute/path/outside/repository/strategy-packages.db

# Authenticated solver API (/v1/solver routes and /v1/solver/stream). Requires NARYX_REGISTRY_DB.
# not generated
# NARYX_SOLVER_API_DB=/absolute/path/outside/repository/solver-api.db
# Protocol JSON, at most 1 MiB: {"version":1,"contexts":{"<domainId>":{...}}}. Solver route
# simulation answers 503 for a domain without a context.
# not generated
# NARYX_ADMISSION_CONTEXTS=/absolute/path/to/admission-contexts.json
# Protocol JSON with rpcUrl (read-only), vault, solvers (address to solver id), and assets (address
# to asset reference). FIRM_BONDED quotes are refused without it.
# not generated
# NARYX_BOND_READER_CONFIG=/absolute/path/to/bond-reader.json

# Private RFQ relay and sealed auctions. Requires NARYX_SOLVER_API_DB.
# not generated
# NARYX_PRIVATE_DELIVERY_DB=/absolute/path/outside/repository/private-delivery.db
# Comma-separated encryption suite ids a reviewed release pinned. Empty, private RFQ fails closed
# with 503 PRIVATE_PATH_UNAVAILABLE.
# not generated
# NARYX_RFQ_PINNED_SUITES=hpke-x25519-sha256-aes256gcm

# Solver qualification reads. The database requires both the authorities and the minimum
# activation delay (a decimal integer in the records' time unit).
# not generated
# NARYX_QUALIFICATION_DB=/absolute/path/outside/repository/qualification.db
# not generated
# NARYX_QUALIFICATION_AUTHORITIES=replace-key-id:replace-base58-ed25519-public-key
# not generated
# NARYX_QUALIFICATION_ACTIVATION_DELAY=replace-with-delay-in-record-time-units

# Position and risk reads; snapshots count only when signed by a listed authority.
# not generated
# NARYX_POSITION_DB=/absolute/path/outside/repository/positions.db
# not generated
# NARYX_POSITION_AUTHORITIES=replace-key-id:replace-base58-ed25519-public-key

# Signed strategy book. Requires NARYX_EVIDENCE_DB and NARYX_PUBLIC_ENVIRONMENT.
# not generated
# NARYX_STRATEGY_DB=/absolute/path/outside/repository/strategies.db
# Builder manifests and attributions. Requires NARYX_EVIDENCE_DB and NARYX_PUBLIC_ENVIRONMENT.
# not generated
# NARYX_BUILDER_DB=/absolute/path/outside/repository/builders.db
# Keeper executor: authority-signed strategy health and loopback /internal/keeper routes on the
# private listener. Holds no signing key. Requires NARYX_STRATEGY_DB and NARYX_HEALTH_AUTHORITIES.
# not generated
# NARYX_KEEPER_EXECUTOR_DB=/absolute/path/outside/repository/keeper-executor.db
# not generated
# NARYX_HEALTH_AUTHORITIES=replace-key-id:replace-base58-ed25519-public-key
# Cross-domain coordinations and manual recovery incidents: loopback /internal/coordination and
# /internal/recovery routes plus public signed approvals. Requires NARYX_PUBLIC_ENVIRONMENT.
# not generated
# NARYX_COORDINATION_DB=/absolute/path/outside/repository/coordination.db

# Graph compilation. Protocol JSON, at most 1 MiB:
# {"version":1,"activeRegistryRecords":[...],"resourceLimits":[...]} with at least one limit.
# not generated
# NARYX_GRAPH_COMPILE_CONTEXT=/absolute/path/to/graph-compile-context.json

# Signed market catalogue. The key file is an Ed25519 PKCS#8 PEM private key (at most 4096 bytes)
# referenced by path only; the key never goes in this file or the repository. Requires
# NARYX_CATALOGUE_AUTHORITY (the signing key id) and NARYX_PUBLIC_ENVIRONMENT.
# not generated
# NARYX_CATALOGUE_KEY_FILE=/absolute/path/outside/repository/catalogue-authority.pem
# not generated
# NARYX_CATALOGUE_AUTHORITY=replace-with-catalogue-key-id

# ---------------------------------------------------------------------------
# (e) Local development only. Never set these in a deployment.
# ---------------------------------------------------------------------------

# Only "true" counts. Allows a non-loopback NARYX_API_HOST, exposing every private route.
# not generated
NARYX_ALLOW_UNSAFE_DEVELOPMENT_BIND=false

# Fixture mode composes the fixed-price local catalog and the fixture lifecycle routes
# (/internal/terminal/attempts/{id}/prepare|open|observation-ambiguity|controller-recovery|close)
# that record invented receipts. It requires a loopback NARYX_API_HOST, defaults unset core store
# paths to /tmp/naryx-local, and refuses to start together with
# NARYX_SOLANA_LOCAL_ENVIRONMENT_MANIFEST, any *_RUNTIME_ENABLED=true, or the execution policy.
# not generated
NARYX_LOCAL_FIXTURE_MODE=false

# Manifest-validated local Solana validator. Not combinable with fixture mode. When the manifest
# is set, the expected local solver public key and the preparation database are required.
# not generated
# NARYX_SOLANA_LOCAL_ENVIRONMENT_MANIFEST=/absolute/path/to/environment-manifest.json
# not generated
# NARYX_SOLANA_LOCAL_SOLVER_ID=replace-with-local-solver-public-key
# not generated
# NARYX_API_SOLANA_LOCAL_PREPARATION_DB=/absolute/path/outside/repository/api-solana-preparations.db
