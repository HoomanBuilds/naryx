# services/indexer configuration. Placeholder values only; never commit a filled-in .env.
# Load with `node --env-file=<file> dist/main.js` or a systemd EnvironmentFile. Every path must be
# absolute and outside the repository checkout. The indexer holds no key and sends no transaction.

# ---------------------------------------------------------------------------
# Generated values
# ---------------------------------------------------------------------------
# After a reviewed testnet deployment, deployments/tools/release-manifests.mjs writes one env file
# per EVM network from deployments/evm/<network>/release.template.json (passed with --release next
# to deployments/tools/release-common.template.json; see deployments/tools/README.md):
# env/indexer-base-sepolia.env and env/indexer-arbitrum-sepolia.env. Each sets NARYX_INDEXER_DB,
# NARYX_INDEXER_EVM_DOMAIN, NARYX_INDEXER_EVM_RPC_URLS, NARYX_INDEXER_EVM_START_HEIGHT, and that
# network's contract lists. Variables marked "not generated" are set by hand.

# ---------------------------------------------------------------------------
# Indexer process (dist/main.js)
# ---------------------------------------------------------------------------
# One process follows one EVM chain, so the NARYX_INDEXER_EVM_* variables always describe a single
# domain. Base Sepolia and Arbitrum Sepolia run as two processes, each with its own env file and its
# own database. Adding a contract, vault, or coordinator address later applies only to blocks indexed
# after the change; reindex into a fresh database to cover earlier heights.

# Absolute path of the SQLite receipt index, e.g.
# /absolute/path/outside/repository/indexer/base-sepolia.db
# Unset or empty: the indexer is off (it logs that and exits). A relative path fails startup.
# Generated: <data-dir>/indexer/<network>.db.
NARYX_INDEXER_DB=

# Required when NARYX_INDEXER_DB is set. CAIP-2 eip155:<decimal chain id> of the one chain this
# process follows. Every endpoint must answer eth_chainId with that id on every pass, or nothing is
# indexed. Generated: eip155:84532 (Base Sepolia) or eip155:421614 (Arbitrum Sepolia).
NARYX_INDEXER_EVM_DOMAIN=eip155:84532

# Required when NARYX_INDEXER_DB is set. 1 to 5 distinct endpoints of that chain, comma separated;
# https, or http to 127.0.0.1 or localhost. Every listed endpoint must agree on each block's hash,
# parent, and logs, or the pass fails and retries. One endpoint grades evidence CONTROLLER_ATTESTED;
# two or more independent endpoints grade it VENUE_API_CORROBORATED.
# Generated with one endpoint, from NARYX_BASE_SEPOLIA_RPC_URL or NARYX_ARBITRUM_SEPOLIA_RPC_URL;
# append a second independent endpoint for corroborated evidence.
NARYX_INDEXER_EVM_RPC_URLS=https://replace-with-reviewed-base-sepolia-rpc-1,https://replace-with-reviewed-base-sepolia-rpc-2

# Comma-separated 0x addresses (20 bytes) of settlement contracts that emit PackageVerified and
# PackageExecuted (on Base Sepolia, the package verifier). Default empty. At least one of this and
# NARYX_INDEXER_EVM_ASYNC_COORDINATORS must list an address, or startup fails.
# Generated for Base Sepolia only.
NARYX_INDEXER_EVM_CONTRACTS=0xreplace-with-package-verifier-address

# Optional. Distinct comma-separated 0x addresses of PerformanceBondVault contracts whose logs are
# indexed with settlement logs. Default empty: no bond indexing. Generated for Base Sepolia only.
NARYX_INDEXER_EVM_BOND_VAULTS=0xreplace-with-performance-bond-vault-address

# Optional. Distinct comma-separated 0x addresses of AsyncBondedPackageCoordinator contracts whose
# package lifecycle logs are indexed. Default empty. Generated for Arbitrum Sepolia only.
NARYX_INDEXER_EVM_ASYNC_COORDINATORS=

# First block indexed while the database is empty; later passes resume after the stored tip.
# Nonnegative integer. Unset or empty reads as 0 (genesis), which means a very long catch-up at
# 50 blocks per pass, so always set it. Generated: the deployment block of the package verifier
# (Base Sepolia) or the coordinator (Arbitrum Sepolia).
NARYX_INDEXER_EVM_START_HEIGHT=replace-with-package-verifier-deployment-block

# not generated. Milliseconds between passes; each pass ingests at most 50 blocks. Integer of at
# least 1000. Unset: 5000. An empty value fails startup: remove the line instead of blanking it.
NARYX_INDEXER_INTERVAL_MS=5000

# Arbitrum Sepolia runs as a second process with its own env file and database
# (generated as env/indexer-arbitrum-sepolia.env):
# NARYX_INDEXER_DB=/absolute/path/outside/repository/indexer/arbitrum-sepolia.db
# NARYX_INDEXER_EVM_DOMAIN=eip155:421614
# NARYX_INDEXER_EVM_RPC_URLS=https://replace-with-reviewed-arbitrum-sepolia-rpc-1,https://replace-with-reviewed-arbitrum-sepolia-rpc-2
# NARYX_INDEXER_EVM_CONTRACTS=
# NARYX_INDEXER_EVM_BOND_VAULTS=
# NARYX_INDEXER_EVM_ASYNC_COORDINATORS=0xreplace-with-async-bonded-package-coordinator-address
# NARYX_INDEXER_EVM_START_HEIGHT=replace-with-coordinator-deployment-block
# NARYX_INDEXER_INTERVAL_MS=5000

# ---------------------------------------------------------------------------
# Reconciliation report CLI (dist/report-cli.js, not generated)
# ---------------------------------------------------------------------------
# One-shot and read-only. Run per report, for example
# `node --env-file=<indexer env file> dist/report-cli.js` with the NARYX_REPORT_* values set in the
# shell (a shell value wins over the file). It reads NARYX_INDEXER_DB above and writes report.json,
# report.csv, and disclosures.json (mode 600; holds the salts behind every field commitment, so keep
# it private) into NARYX_REPORT_OUT_DIR. Every NARYX_REPORT_* variable is required; none is generated.

# not generated. CAIP-2 domain the index followed, e.g. eip155:84532. Empty fails.
NARYX_REPORT_DOMAIN=eip155:84532
# not generated. Inclusive canonical block height range, nonnegative integers with TO at least FROM.
# Unset or empty reads as 0. More than 10000 packages in the range fails; split the range.
NARYX_REPORT_FROM_HEIGHT=replace-with-first-block-height
NARYX_REPORT_TO_HEIGHT=replace-with-last-block-height
# not generated. Report identifier, 1 to 128 ASCII bytes. Empty fails.
NARYX_REPORT_ID=replace-with-report-id
# not generated. Reporting period in Unix milliseconds; END must be greater than START.
NARYX_REPORT_PERIOD_START_MS=replace-with-period-start-unix-ms
NARYX_REPORT_PERIOD_END_MS=replace-with-period-end-unix-ms
# not generated. Absolute output directory outside the repository; created if missing.
NARYX_REPORT_OUT_DIR=/absolute/path/outside/repository/reports/replace-with-report-id
