# Private terminal service (services/api). Required for any testnet execution.
NEXT_PUBLIC_PRIVATE_TERMINAL_API_BASE_URL=http://127.0.0.1:8787

# Public v1 market API and the package market the chart and book show.
NEXT_PUBLIC_NARYX_PUBLIC_API_BASE_URL=http://127.0.0.1:8789
NEXT_PUBLIC_NARYX_PACKAGE_MARKET_ID=

# Read-only RPC endpoints for wallet balances. Public endpoints are used when unset.
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=

# The quote asset each deployed package route settles in (from its runtime manifest).
NEXT_PUBLIC_SOLANA_DEVNET_QUOTE_MINT=
NEXT_PUBLIC_BASE_SEPOLIA_QUOTE_TOKEN=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_QUOTE_TOKEN=

# Order context id for Arbitrum Sepolia when no live Arbitrum snapshot provides it.
NEXT_PUBLIC_ARBITRUM_SEPOLIA_CONTEXT_ID=
