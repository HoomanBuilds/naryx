# Generated: deployments/tools/release-manifests.mjs writes web/.env.production with these values
# from the deployment. NEXT_PUBLIC_* values are compiled into the bundle; rebuild after any change.

# Private terminal service (services/api). Required for any testnet execution. In a deployment this
# is the public HTTPS URL of the reverse proxy in front of the API (deployments/GO-LIVE.md, step 6).
NEXT_PUBLIC_PRIVATE_TERMINAL_API_BASE_URL=http://127.0.0.1:8787

# Public origin of the web app, for absolute metadata URLs (Open Graph, sitemap, robots). Optional:
# on Vercel the production domain (VERCEL_PROJECT_PRODUCTION_URL) is used when this is unset.
NEXT_PUBLIC_SITE_URL=

# Optional public v1 market API (the API's public listener, NARYX_PUBLIC_API_PORT, 8790 locally) and
# the package market its book, tape, and solver panels show. Leave both empty when it does not run:
# those panels then show as not configured and quote-based trading is unaffected.
NEXT_PUBLIC_NARYX_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_NARYX_PACKAGE_MARKET_ID=

# Read-only RPC endpoints for wallet balances. Public endpoints are used when unset.
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=

# The quote asset each deployed package route settles in (from its runtime manifest). The hosted
# test deployment uses free test USDC: Naryx Test USDC on Base Sepolia, GMX's USDC.SG on Arbitrum
# Sepolia, and the test perp faucet mint on Solana Devnet. The Portfolio page offers a claim when
# the configured token has a public faucet.
NEXT_PUBLIC_SOLANA_DEVNET_QUOTE_MINT=
NEXT_PUBLIC_BASE_SEPOLIA_QUOTE_TOKEN=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_QUOTE_TOKEN=

# Order context id for Arbitrum Sepolia when no live Arbitrum snapshot provides it.
NEXT_PUBLIC_ARBITRUM_SEPOLIA_CONTEXT_ID=
